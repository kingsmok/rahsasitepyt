# ============================================================
# ⚙️ تنظیمات محیطی آکادمی آنلاین — نمونه کامل
# ─────────────────────────────────────────────────────────────
# ۱) این فایل را در پوشه پروژه کپی کنید:
#        cp .env.example .env
# ۲) مقادیر را ویرایش کنید (به‌خصوص SECRET_KEY و FLASK_ENV)
# ۳) فایل .env در .gitignore است و هرگز commit نمی‌شود.
# ۴) بعد از هر تغییر: ری‌استارت سرور / هاست.
#    (تست محلی: python app.py | هاست: touch passenger_wsgi.py)
# ============================================================

# ------------------------------------------------------------
# 🔐 امنیت
# ------------------------------------------------------------
# کلید رمزنگاری جلسات/کوکی‌ها — حتماً مقدار تصادفی طولانی بگذارید:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-to-a-long-random-string-64-char-min

# کوکی جلسه فقط روی HTTPS ارسال شود (در production = 1)
# SESSION_COOKIE_SECURE=1

# اگر پشت nginx/هاست اشتراکی هستید و IP واقعی کاربر مهم است (rate limit):
# TRUST_PROXY=1

# ------------------------------------------------------------
# 🌍 حالت اجرا
# ------------------------------------------------------------
# development = تست محلی (خطاهای کامل + دیباگ)
# production  = سرور واقعی (لاگ استاندارد + کوکی امن + نیاز به SECRET_KEY امن)
# ⚠️ روی هاست حتماً production بگذارید (نصب‌کننده خودش این کار را می‌کند)
FLASK_ENV=production
APP_ENV=production

# همه قابلیت‌های نمایشی (OTP روی صفحه، پرداخت ساختگی و seed دمو) خاموش‌اند.
# در production حتی با مقدار 1 نیز فعال نمی‌شوند. برای سایت واقعی تغییر ندهید.
ENABLE_DEMO_FEATURES=0

# فقط برای مهاجرت موقت کاربران بسیار قدیمی با هش MD5؛ در سایت واقعی صفر بماند.
ALLOW_LEGACY_MD5=0

# کلید تعمیر اضطراری نصب را نصب‌کننده به‌صورت تصادفی در .env واقعی می‌سازد.
# این نمونه را دستی با مقدار قابل حدس پر نکنید و هرگز در Git قرار ندهید.
# INSTALL_REPAIR_TOKEN=<generated-by-installer>

# ------------------------------------------------------------
# 🔄 بروزرسانی کد از GitHub
# ------------------------------------------------------------
# اگر تنظیم git_repo_url در پنل خالی باشد، origin فعلی استفاده می‌شود.
# در صورت نیاز می‌توان URL مخزن را از محیط تعیین کرد (توکن را در Git commit نکنید).
GIT_REPO_URL=
# برای Webhook اتوماتیک GitHub، این Secret را در سرور قرار دهید؛ هرگز داخل Git commit نکنید.
GITHUB_WEBHOOK_SECRET=
# شاخهٔ هدف (خالی = تشخیص default branch یا شاخهٔ فعلی)
GIT_BRANCH=
# در صورت تغییر requirements.txt، نصب خودکار وابستگی‌ها انجام شود (پیش‌فرض 1)
UPDATE_INSTALL_DEPENDENCIES=1
# زمان‌های حداکثری برحسب ثانیه
GIT_FETCH_TIMEOUT=300
DB_MIGRATION_TIMEOUT=900
PIP_INSTALL_TIMEOUT=900

# ------------------------------------------------------------
# 🗄 دیتابیس — SQLite (پیش‌فرض) یا MySQL
# ------------------------------------------------------------
# خالی = SQLite محلی (instance/academy.db — خودکار، بدون نیاز به تنظیم)
# MySQL = فقط این خط را فعال کنید (هاست‌های اشتراکی/هاستینگر):
DATABASE_URL=
# نمونه کامل (نام کاربری/رمز/آدرس را از پنل هاست بردارید):
# DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost/DBNAME?charset=utf8mb4
#
# ⚠️ هنگام استفاده از MySQL حتماً:
#   ۱) دیتابیس را در هاست با utf8mb4 بسازید:
#        CREATE DATABASE DBNAME CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   ۲) بعد از اولین اجرا، داده‌های SQLite را منتقل کنید:
#        python3 scripts/migrate_sqlite_to_mysql.py
#   ۳) تنظیمات و داده‌ها به‌صورت خودکار ساخته می‌شوند (db.create_all)

# ------------------------------------------------------------
# 📁 لاگ‌ها و آپلود
# ------------------------------------------------------------
# پوشه لاگ‌ها (پیش‌فرض: logs/ کنار پروژه)
LOG_DIR=logs

# سقف حجم آپلود (بایت) — پیش‌فرض: 50 مگابایت
# MAX_CONTENT_LENGTH=52428800

# ------------------------------------------------------------
# ⚡ عملکرد — Redis (اختیاری ولی توصیه‌شده برای production)
# ------------------------------------------------------------
# اگر تنظیم شود: rate limit و کش‌ها از Redis استفاده می‌کنند (چند-پردازنده)
# وگرنه حالت حافظه داخلی (مناسب dev)
REDIS_URL=
# نمونه: REDIS_URL=redis://localhost:6379/0

# ============================================================
# 🛰 سرویس‌های رایگان (اختیاری — خالی = غیرفعال)
# ============================================================

# Microsoft Clarity — تحلیل رفتار کاربر
# (شناسه پروژه از https://clarity.microsoft.com)
CLARITY_ID=

# Crisp Chat — پشتیبانی آنلاین
# (شناسه وب‌سایت از https://app.crisp.chat)
CRISP_WEBSITE_ID=

# Groq — چت‌بات و تولید مقاله با Llama-3 (کلید رایگان)
# (از https://console.groq.com/keys)
GROQ_API_KEY=

# Bing Webmaster — ایندکس سریع URL (IndexNow)
# (کلید از https://www.bing.com/webmasters)
BING_API_KEY=
# آدرس عمومی فایل کلید در ریشه سایت — مثلاً:
# BING_KEY_LOCATION=https://academy.ir/0123456789abcdef.txt
BING_KEY_LOCATION=

# ============================================================
# ℹ️ نکته: تنظیمات زیر در دیتابیس ذخیره می‌شوند (نه این فایل)
# و از پنل مدیریت قابل تغییرند: پنل ادمین ← ⚙️ تنظیمات سوپر
#   - base_url (آدرس سایت برای ایمیل/سئو)
#   - smtp_host / smtp_port / smtp_user / smtp_pass / smtp_from (ایمیل)
#   - sms_provider و کلیدهای پیامک (کاوه‌نگار/ملی‌پیامک/فراز)
#   - کلیدهای درگاه پرداخت (زرین‌پال/آیدی‌پی/...)
#   - dk_api_base / dk_access_token (دیجی‌کالا) و basalam_webhook_secret
# ============================================================

# ── بهینه‌سازی اتصال MySQL (هاست اشتراکی: ۵ و ۱۰ امن است) ──
# تعداد اتصال‌های ثابت و اضافه برای هر ورکر — جمع کل = ورکرها × (پول + اورفلو)
# اگر «Too many connections» دیدید این‌ها را کمتر کنید (مثلاً ۳ و ۵)
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
