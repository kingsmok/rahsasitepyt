# ── محیط و اسرار ──
.env
*.env.local

# ── دیتابیس و داده محلی ──
instance/*.db
instance/*.db-wal
instance/*.db-shm
instance/backups/
instance/uploads/
instance/libraries/
instance/.installed
instance/.install_progress.json
instance/.update_progress.json
instance/update_history.json
instance/.update_commit

# ── لاگ‌ها ──
logs/
*.log

# ── کش‌ها ──
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# ── محیط مجازی ──
venv/
.venv/
env/

# قفلهای فرآیندی
instance/*.lock

# ── آپلودهای عمومی (فایل .htaccess محافظ commit می‌شود، محتوا نه) ──
static/uploads/*
!static/uploads/.htaccess
!static/uploads/lessons/
static/img/uploads/*
!static/img/uploads/.htaccess
