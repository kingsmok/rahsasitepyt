# ============================================================================
# ⚡ تنظیمات پیشنهادی MySQL/MariaDB برای آکادمی آنلاین — سرورهای ۲ گیگ رم / ۲ هسته
# ============================================================================
# طرز استفاده:
#   - اگر کنترل کامل سرور دارید: این فایل را کپی کنید به
#       /etc/mysql/conf.d/academy.cnf        (Debian/Ubuntu)
#       /etc/my.cnf.d/academy.cnf            (CentOS/RHEL)
#     سپس:  sudo systemctl restart mysql   (یا mariadb)
#   - اگر هاست اشتراکی دارید: همین مقادیر را از پشتیبانی هاست «درخواست» کنید
#     (بیشتر هاست‌ها innodb_buffer_pool_size را برای شما تنظیم می‌کنند)
#
# ⚠️ مقادیر را با رم واقعی سرور هماهنگ کنید:
#     رم ۱ گیگ  →  innodb_buffer_pool_size = 256M
#     رم ۲ گیگ  →  innodb_buffer_pool_size = 512M   (پیشنهادی)
#     رم ۴ گیگ  →  innodb_buffer_pool_size = 1G
# ============================================================================

[mysqld]

# ── مهم‌ترین تنظیم: کش دیتابیس در حافظه (حدود ۵۰٪ رم سرور) ──
# هرچه بیشتر، کوئری‌های تکراری سریع‌تر (بدون لمس دیسک)
innodb_buffer_pool_size = 512M

# ── نوشتن لاگ تراکنش‌ها: هر ۱ ثانیه به‌جای هر commit ──
# سرعت نوشتن (سفارش‌ها/نظرات/تیکت‌ها) را چند برابر می‌کند.
# ریسک: در قطع ناگهانی برق حداکثر ۱ ثانیه تراکنش آخر از دست می‌رود (معمولاً قابل قبول)
innodb_flush_log_at_trx_commit = 2

# ── هر جدول در فایل جداگانه (مدیریت آسان‌تر + فشرده‌سازی بهتر) ──
innodb_file_per_table = ON

# ── سایز فایل لاگ اینودب — با رشد دیتابیس بزرگش کنید ──
innodb_log_file_size = 64M
innodb_log_buffer_size = 8M

# ── اتصال‌ها: حداقل به اندازه «ورکرهای گونی‌کورن × (پول + اورفلو)» + ۲۰ ──
# (پیش‌فرض اپ: ۳ ورکر × ۱۵ = ۴۵ اتصال → ۱۰۰ اتصال کافی و امن است)
max_connections = 150

# ── پاکت بزرگ‌تر برای آپلود/بکاپ ──
max_allowed_packet = 64M

# ── جدول‌های موقتی در حافظه (مرتب‌سازی/گروه‌بندی بزرگ) ──
tmp_table_size = 32M
max_heap_table_size = 32M

# ── بافرهای مرتب‌سازی و JOIN (برای هاست کوچک محتاطانه) ──
sort_buffer_size = 1M
join_buffer_size = 1M

# ── تعداد سطرهای نمونه برای آمار ایندکس (دقیق‌تر = انتخاب بهتر ایندکس) ──
innodb_stats_persistent_sample_pages = 64

# ── (اختیاری) لاگ کوئری‌های کند — برای پیدا کردن باقی کوئری‌های سنگین ──
slow_query_log = 1
slow_query_log_file = /var/log/mysql/academy-slow.log
long_query_time = 1

# ⚠️ در MySQL 8 گزینه query_cache حذف شده — فعالش نکنید (هیچ اثری ندارد)
# ⚠️ در MariaDB می‌توانید برای سایت‌های خواندنی:  query_cache_type = 1 ، query_cache_size = 32M
#    (فقط اگر ترافیکتان بیشتر «خواندن» است؛ بعد از هر نوشتن کش باطل می‌شود)
