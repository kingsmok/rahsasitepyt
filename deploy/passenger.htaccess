# ============================================================
# Phusion Passenger — .htaccess برای هاست‌های اشتراکی
# این فایل را با نام .htaccess در ریشه پروژه (کنار passenger_wsgi.py)
# کپی کنید و مسیرها را با مسیر واقعی هاست خود جایگزین کنید.
#
# مسیر واقعی را از پنل هاست ببینید، مثلاً:
#   هاستینگر:  /home/username/domain.com
#   سی‌پنل:    /home/username/public_html (یا زیرپوشه پروژه)
# ============================================================

# پوشه ریشه پروژه (جایی که passenger_wsgi.py هست)
PassengerAppRoot /home/username/domain.com

# پایتون محیط مجازی پروژه — حتماً venv بسازید:
#   python3 -m venv venv && bash scripts/install_dependencies.sh ./venv/bin/python
PassengerPython /home/username/domain.com/venv/bin/python

# حالت اجرا: production | development
PassengerAppEnv production

# اگر برنامه در زیرپوشه نصب شده (مثلاً /app) این خط را فعال کنید:
# PassengerBaseURI /app

# خطاهای دوستانه خاموش (پیام واقعی خطا در لاگ‌ها)
PassengerFriendlyErrorPages off

# افزایش سقف حجم آپلود (هماهنگ با MAX_CONTENT_LENGTH اپ)
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# ============================================================
# 🔒 محافظت از پوشهٔ آپلود (سی‌پنل / هاست اشتراکی)
# ------------------------------------------------------------
# ⚠️ مهم برای Google Safe Browsing: روی هاست اشتراکی، فایل‌های داخل
# static/uploads مستقیماً توسط آپاچی سرو می‌شوند (بدون عبور از پایتون).
# اگر مهاجم فایل php/html/svg آپلود کند، زیر دامنهٔ شما اجرا می‌شود و
# کروم کل دامنه را با پیام «Dangerous site» مسدود می‌کند.
# این فایل را با نام .htaccess داخل پوشهٔ static/uploads هم کپی کنید.
# ============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(?i:jpe?g|png|gif|webp|avif|mp4|webm|mp3|wav|ogg|pdf)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

# اجرای هرگونه اسکریپت در پوشه آپلود ممنوع
<Directory "static/uploads">
    php_flag engine off
    Options -ExecCGI -Indexes
    AddType text/plain .php .php3 .php4 .php5 .phtml .pl .py .cgi .sh .js .html .htm .svg
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
        Header set Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; sandbox"
        Header set X-Robots-Tag "noindex, nofollow"
    </IfModule>
</Directory>
