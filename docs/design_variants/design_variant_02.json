  "components": {
    "desktop_header": "<header class=\"dv-widget\" style=\"background:var(--card);border-bottom:1px solid var(--border)\">\n  <div class=\"dv-container dv-py-2 dv-flex dv-items-center dv-justify-between\" style=\"border-bottom:1px solid var(--border)\">\n    <div class=\"dv-flex dv-gap-3\" style=\"color:var(--text-2);font-size:12px\">\n      <span>📞 ۰۲۱-۱۲۳۴۵۶۷۸</span><span>✉️ info@academy.ir</span>\n    </div>\n    <div class=\"dv-flex dv-gap-3\" style=\"color:var(--text-2);font-size:12px\">\n      <a href=\"#\" style=\"color:var(--primary)\">ورود</a><span>|</span><a href=\"#\">ثبت‌نام</a>\n    </div>\n  </div>\n  <div class=\"dv-container dv-py-3 dv-flex dv-items-center dv-justify-between dv-gap-4\">\n    <div class=\"dv-flex dv-items-center dv-gap-2\">\n      <div class=\"dv-logo-ic\">ز</div>\n      <div><b class=\"dv-text-lg dv-font-black\" style=\"color:var(--text)\">آکادمی آنلاین</b>\n      <small class=\"dv-block dv-text-xs\" style=\"color:var(--primary)\">زعفرانی قائنات</small></div>\n    </div>\n    <div class=\"dv-mega\">\n      <button class=\"dv-mega-trigger\">☰ همه دسته‌ها</button>\n      <div class=\"dv-mega-panel\">\n        <div class=\"dv-mega-col\"><b>برنامه‌نویسی</b><a href=\"#\">پایتون</a><a href=\"#\">جنگو</a><a href=\"#\">ری‌اکت</a></div>\n        <div class=\"dv-mega-col\"><b>طراحی</b><a href=\"#\">UI/UX</a><a href=\"#\">فتوشاپ</a><a href=\"#\">موشن</a></div>\n        <div class=\"dv-mega-col\"><b>بازاریابی</b><a href=\"#\">دیجیتال</a><a href=\"#\">سئو</a><a href=\"#\">تبلیغات</a></div>\n      </div>\n    </div>\n    <div class=\"dv-search\">\n      <input type=\"text\" placeholder=\"جستجوی دوره، استاد، مهارت...\" class=\"dv-search-in\">\n      <button class=\"dv-search-btn\">🔍</button>\n    </div>\n    <a class=\"dv-btn dv-btn-primary\" href=\"#\">ورود / ثبت‌نام</a>\n  </div>\n</header>",
    "mobile_header": "<div class=\"dv-widget\">\n  <header class=\"dv-mb-bar dv-flex dv-items-center dv-justify-between\">\n    <button class=\"dv-mb-fab\">☰</button>\n    <b style=\"font-size:15px\">آکادمی آنلاین</b>\n    <button class=\"dv-mb-fab\">🔍</button>\n  </header>\n  <nav class=\"dv-drawer dv-drawer-right\">\n    <div class=\"dv-drawer-head\"><b>منو</b><button class=\"dv-mb-fab\">✕</button></div>\n    <a href=\"#\"><span>🏠</span>خانه</a><a href=\"#\"><span>📚</span>دوره‌ها</a><a href=\"#\"><span>👨‍🏫</span>اساتید</a><a href=\"#\"><span>📝</span>وبلاگ</a><a href=\"#\"><span>✉️</span>تماس</a>\n  </nav>\n  <div class=\"dv-bottom-nav\">\n    <a href=\"#\" class=\"dv-bn-item dv-bn-active\"><span>🏠</span><small>خانه</small></a>\n    <a href=\"#\" class=\"dv-bn-item\"><span>📚</span><small>دوره‌ها</small></a>\n    <a href=\"#\" class=\"dv-bn-item\"><span>🔍</span><small>جستجو</small></a>\n    <a href=\"#\" class=\"dv-bn-item\"><span>👤</span><small>پروفایل</small></a>\n  </div>\n</div>",
    "desktop_footer": "<footer class=\"dv-widget\" style=\"background:var(--footer-bg);color:var(--footer-text);padding:22px 0\">\n  <div class=\"dv-container dv-flex dv-items-center dv-justify-between dv-gap-3 dv-flex-wrap\">\n    <div class=\"dv-flex dv-items-center dv-gap-2\"><span class=\"dv-logo-ic\">ز</span><b style=\"color:var(--footer-head)\">زعفرانی قائنات</b></div>\n    <div class=\"dv-flex dv-gap-3\" style=\"font-size:13px\"><a href=\"#\">درباره</a><a href=\"#\">تماس</a><a href=\"#\">قوانین</a></div>\n    <span style=\"font-size:12px;color:var(--footer-text-2)\">© ۱۴۰۵ — زعفرانی قائنات</span>\n  </div>\n</footer>",
    "mobile_footer": "<div class=\"dv-widget\">\n  <footer style=\"background:var(--footer-bg);color:var(--footer-text);padding:16px;text-align:center\">\n    <b style=\"color:var(--footer-head)\">زعفرانی قائنات</b>\n    <p class=\"dv-text-sm\" style=\"color:var(--footer-text-2);margin:6px 0 10px\">یادگیری مهارت‌های آینده</p>\n  </footer>\n  <div class=\"dv-sticky-cta\">\n    <a class=\"dv-btn dv-btn-primary\" href=\"#\" style=\"flex:1\">✨ ثبت‌نام رایگان</a>\n    <a class=\"dv-btn dv-btn-accent\" href=\"#\" style=\"flex:1\">💬 پشتیبانی</a>\n  </div>\n</div>",
    "course_card": "<div class=\"dv-widget\">\n  <article class=\"dv-card dv-flex\" style=\"max-width:520px\">\n    <div style=\"width:150px;background:linear-gradient(160deg,#1F3A5F,#C8912A);display:flex;align-items:center;justify-content:center;font-size:38px\">📚</div>\n    <div class=\"dv-flex-1\" style=\"padding:14px 16px\">\n      <small style=\"color:var(--primary);font-weight:700\">مهارتی - پرانرژی</small>\n      <h3 class=\"dv-text-sm dv-font-black\" style=\"margin:4px 0 6px\">دوره جامع طراحی UI/UX</h3>\n      <div style=\"font-size:12px;color:var(--text-3)\">⭐ ۴.۹ · 👥 ۱۸۴۱ · ⏱ ۴۲س</div>\n      <div class=\"dv-flex dv-items-center dv-justify-between dv-mt-2\">\n        <b style=\"color:var(--primary)\">۸۹۰,۰۰۰ <small>تومان</small></b>\n        <a class=\"dv-btn dv-btn-outline\" href=\"#\">جزئیات</a>\n      </div>\n    </div>\n  </article>\n</div>",
    "video_section": "<div class=\"dv-widget\">\n  <div class=\"dv-flex dv-gap-3\" style=\"flex-direction:row\">\n    <div style=\"flex:1;min-width:200px\"><b style=\"font-size:14px\">🎬 لیست پخش</b><div class=\"dv-pl-item dv-pl-active\"><span class=\"dv-pl-num\">1</span><div><b>قسمت 1 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">2</span><div><b>قسمت 2 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">3</span><div><b>قسمت 3 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">4</span><div><b>قسمت 4 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-attach\"><b>📎 فایل‌های ضمیمه</b>\n      <a href=\"#\">📄 اسلاید جلسه.pdf</a><a href=\"#\">📦 کد تمرین.zip</a><a href=\"#\">📊 دیتاست.xlsx</a></div></div>\n    <div style=\"flex:2\"><div class=\"dv-player\">\n      <div style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:56px;color:#fff\">▶</div>\n      <div class=\"dv-player-bar\"><span>قسمت ۱ — زعفرانی قائنات</span><span style=\"font-size:12px\">⏱ ۱۲:۳۴ / ۴۵:۰۰</span></div>\n    </div><div class=\"dv-notes\"><b>📝 یادداشت‌های من</b>\n      <textarea rows=\"3\" placeholder=\"نکته‌های این جلسه را بنویسید...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">ذخیره یادداشت</button></div></div>\n  </div>\n</div>",
    "about_section": "<div class=\"dv-widget\">\n  <div class=\"dv-flex dv-gap-3\" style=\"flex-wrap:wrap\">\n    <div style=\"flex:1;min-width:240px;background:var(--card);border-radius:16px;padding:20px;border-top:4px solid #C8912A\">\n      <b>🎯 مأموریت ما</b><p class=\"dv-text-sm\" style=\"color:var(--text-2);margin-top:6px\">آموزش مهارت‌های واقعی به زبان ساده برای همه ایرانیان.</p></div>\n    <div style=\"flex:1;min-width:240px;background:var(--card);border-radius:16px;padding:20px;border-top:4px solid #E8B54A\">\n      <b>👁 چشم‌انداز</b><p class=\"dv-text-sm\" style=\"color:var(--text-2);margin-top:6px\">مرجع اول آموزش آنلاین با هویت ایرانی در منطقه.</p></div>\n    <div style=\"flex:1;min-width:240px;background:var(--card);border-radius:16px;padding:20px;border-top:4px solid #1F3A5F\">\n      <b>🏆 افتخارات</b><p class=\"dv-text-sm\" style=\"color:var(--text-2);margin-top:6px\">۶ سال حضور مستمر، ۵۰ هزار دانشجو، ۲۰۰ دوره موفق.</p></div>\n  </div>\n  <div class=\"dv-flex dv-gap-3\" style=\"margin-top:20px;flex-wrap:wrap\">\n    <div style=\"flex:2;min-width:240px\"><b style=\"font-size:15px\">اساتید برتر</b><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#C8912A\">د</span>\n        <b>استاد دکتر سارا محمدی</b>\n        <small>مدرس ارشد برنامه‌نویسی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#E8B54A\">ع</span>\n        <b>استاد مهندس علی رضایی</b>\n        <small>متخصص طراحی UI/UX</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#1F3A5F\">ن</span>\n        <b>استاد دکتر نگار کریمی</b>\n        <small>دکترای هوش مصنوعی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#C8912A\">ا</span>\n        <b>استاد مهندس امیر حسینی</b>\n        <small>مدرس بازاریابی دیجیتال</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div></div>\n    <div style=\"flex:1;min-width:200px\"><b style=\"font-size:15px\">آمار کلیدی</b><div class=\"dv-stat\"><b>۱۲+</b><small>دوره آموزشی</small></div><div class=\"dv-stat\"><b>۴۹+</b><small>دانشجوی فعال</small></div><div class=\"dv-stat\"><b>۳۵۹+</b><small>ساعت آموزش</small></div><div class=\"dv-stat\"><b>٪۹۰</b><small>رضایت</small></div></div>\n  </div>\n</div>",
    "contact_section": "<div class=\"dv-widget\" style=\"background:linear-gradient(135deg,#C8912A,rgba(200,145,42,0.75));border-radius:22px;padding:30px;color:#fff;display:flex;gap:24px;flex-wrap:wrap\">\n  <div style=\"flex:1;min-width:230px\">\n    <h2 class=\"dv-text-xl dv-font-black\" style=\"color:#fff\">🎯 مشاوره رایگان انتخاب مسیر</h2>\n    <p style=\"opacity:.9;font-size:13px;margin:8px 0 16px\">کارشناسان ما در کمتر از ۲۴ ساعت با شما تماس می‌گیرند.</p>\n    <div style=\"display:flex;flex-direction:column;gap:8px;font-size:13px\">\n      <span>📞 ۰۲۱-۱۲۳۴۵۶۷۸</span><span>✉️ info@academy.ir</span><span>💬 تلگرام: @academy_ir</span>\n    </div>\n  </div>\n  <div style=\"flex:1;min-width:240px\">\n    <form class=\"dv-contact-form\" onsubmit=\"return false\" style=\"background:#fff;border-radius:16px;padding:18px;color:var(--text)\">\n      <b style=\"color:var(--text)\">فرم درخواست مشاوره</b>\n      <input placeholder=\"نام\"><input placeholder=\"شماره موبایل\">\n      <select><option>دوره برنامه‌نویسی</option><option>دوره طراحی</option><option>دوره بازاریابی</option></select>\n      <button class=\"dv-btn dv-btn-accent dv-w-full\">درخواست مشاوره</button>\n    </form>\n  </div>\n</div>"
