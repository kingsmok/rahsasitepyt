  "components": {
    "desktop_header": "<header class=\"dv-widget\" style=\"background:var(--card)\">\n  <div class=\"dv-container dv-py-4\">\n    <div class=\"dv-flex dv-items-center dv-justify-between\"><div class=\"dv-flex dv-items-center dv-gap-2\">\n      <div class=\"dv-logo-ic\">ا</div>\n      <div><b class=\"dv-text-lg dv-font-black\" style=\"color:var(--text)\">آکادمی آنلاین</b>\n      <small class=\"dv-block dv-text-xs\" style=\"color:var(--primary)\">اناری یزد</small></div>\n    </div><a class=\"dv-btn dv-btn-primary\" href=\"#\">ورود / ثبت‌نام</a></div>\n    <nav class=\"dv-nav-line dv-mt-3\"><a href=\"#\">خانه</a><a href=\"#\">دوره‌ها</a><a href=\"#\">اساتید</a><a href=\"#\">وبلاگ</a><a href=\"#\">درباره ما</a></nav>\n  </div>\n</header>",
    "mobile_header": "<div class=\"dv-widget\">\n  <header class=\"dv-mb-bar dv-flex dv-items-center dv-justify-between\">\n    <button class=\"dv-mb-fab\">☰</button><b>آکادمی آنلاین</b><button class=\"dv-mb-fab\">👤</button>\n  </header>\n  <nav class=\"dv-drawer dv-drawer-right dv-drawer-glass\">\n    <div class=\"dv-drawer-head\"><b>خوش آمدید</b><button class=\"dv-mb-fab\">✕</button></div>\n    <a class=\"dv-btn dv-btn-primary\" href=\"#\">ورود</a>\n    <a href=\"#\"><span>🏠</span>خانه</a><a href=\"#\"><span>📚</span>دوره‌ها</a><a href=\"#\"><span>👨‍🏫</span>اساتید</a><a href=\"#\"><span>📝</span>وبلاگ</a><a href=\"#\"><span>✉️</span>تماس</a>\n  </nav>\n</div>",
    "desktop_footer": "<footer class=\"dv-widget\" style=\"background:var(--footer-bg);color:var(--footer-text)\">\n  <div class=\"dv-container dv-footer-grid\">\n    <div>\n      <span class=\"dv-logo-ic\">ا</span>\n      <div class=\"dv-stats\" style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px\">\n        <div><b style=\"color:var(--footer-head)\">۱۲+</b><small>دوره</small></div>\n        <div><b style=\"color:var(--footer-head)\">۴۹+</b><small>دانشجو</small></div>\n        <div><b style=\"color:var(--footer-head)\">٪۹۰</b><small>رضایت</small></div>\n      </div>\n    </div>\n    <div><b style=\"color:var(--footer-head)\">لینک‌ها</b><a href=\"#\">خانه</a><a href=\"#\">دوره‌ها</a><a href=\"#\">وبلاگ</a><a href=\"#\">سوالات</a></div>\n    <div><b style=\"color:var(--footer-head)\">مشاوره رایگان</b>\n      <p class=\"dv-text-sm\" style=\"color:var(--footer-text-2)\">شماره خود را بگذارید تا تماس بگیریم</p>\n      <div class=\"dv-news\"><input placeholder=\"شماره موبایل\"><button class=\"dv-btn dv-btn-accent\">درخواست</button></div>\n      <div class=\"dv-socials\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a><a href=\"#\">🐦</a></div></div>\n  </div>\n</footer>",
    "mobile_footer": "<div class=\"dv-widget\">\n  <footer style=\"background:var(--card);border-top:1px solid var(--border);padding:14px 16px\">\n    <div class=\"dv-flex dv-items-center dv-justify-between\">\n      <b style=\"font-size:14px\">اناری یزد</b>\n      <div class=\"dv-flex dv-gap-2\" style=\"font-size:16px\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a></div>\n    </div>\n    <div class=\"dv-news dv-mt-2\"><input placeholder=\"ایمیل برای تخفیف‌ها\"><button class=\"dv-btn dv-btn-accent\">عضویت</button></div>\n    <div style=\"font-size:11px;color:var(--text-3);text-align:center;margin-top:10px\">© ۱۴۰۵ اناری یزد</div>\n  </footer>\n</div>",
    "course_card": "<div class=\"dv-widget\">\n  <article class=\"dv-card dv-card-course\">\n    <div class=\"dv-card-thumb\" style=\"background:#000;position:relative\">\n      <span style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:42px;color:#fff;opacity:.9\">▶</span>\n      <span class=\"dv-badge\" style=\"background:var(--danger);color:#fff\">پیش‌نمایش</span>\n    </div>\n    <div class=\"dv-card-body\">\n      <small style=\"color:var(--primary)\">ویدیو معرفی</small>\n      <h3 class=\"dv-text-base dv-font-black\">دوره جامع یادگیری ماشین</h3>\n      <div class=\"dv-flex dv-gap-2\" style=\"font-size:12px;color:var(--text-3)\"><span>🎬 ۲۷ جلسه</span><span>🏅 گواهینامه</span></div>\n      <div class=\"dv-flex dv-items-center dv-justify-between dv-mt-2\">\n        <b style=\"color:var(--primary)\">۸۹۰,۰۰۰ <small>تومان</small></b>\n        <a class=\"dv-btn dv-btn-primary\" href=\"#\">مشاهده دوره</a>\n      </div>\n    </div>\n  </article>\n</div>",
    "video_section": "<div class=\"dv-widget\">\n  <div class=\"dv-flex dv-gap-3\" style=\"flex-wrap:wrap\">\n    <div style=\"flex:2;min-width:260px\"><div class=\"dv-player\">\n      <div style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:56px;color:#fff\">▶</div>\n      <div class=\"dv-player-bar\"><span>قسمت ۱ — اناری یزد</span><span style=\"font-size:12px\">⏱ ۱۲:۳۴ / ۴۵:۰۰</span></div>\n    </div>\n      <div class=\"dv-flex dv-gap-2\" style=\"margin-top:10px\">\n        <button class=\"dv-btn dv-btn-primary\" style=\"flex:1\">⬇ دانلود ویدیو</button>\n        <button class=\"dv-btn dv-btn-outline\" style=\"flex:1\">📝 یادداشت</button>\n      </div></div>\n    <div style=\"flex:1;min-width:220px\"><b>🎬 لیست پخش — اناری یزد</b><div class=\"dv-pl-item dv-pl-active\"><span class=\"dv-pl-num\">1</span><div><b>قسمت 1 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">2</span><div><b>قسمت 2 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">3</span><div><b>قسمت 3 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">4</span><div><b>قسمت 4 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div></div>\n  </div>\n</div>",
    "about_section": "<div class=\"dv-widget\">\n  <div class=\"dv-flex dv-gap-3\" style=\"align-items:center;flex-wrap:wrap\">\n    <div style=\"flex:1;min-width:230px;height:160px;border-radius:18px;background:linear-gradient(135deg,#B3272E,#E3CFA4);display:flex;align-items:center;justify-content:center;font-size:56px\">🏛</div>\n    <div style=\"flex:1.4;min-width:250px\">\n      <h2 class=\"dv-text-xl dv-font-black\">درباره اناری یزد</h2>\n      <p class=\"dv-text-sm\" style=\"color:var(--text-2);margin:8px 0 14px\">\n        قرمز اناری، شنی کویر و زیتونی تیره — مدرن و پویا برای دوره‌های هنر و طراحی — با تیمی از متخصصان و هنرمندان ایرانی.</p>\n      <div class=\"dv-flex dv-gap-2\"><div class=\"dv-stat\"><b>۱۲+</b><small>دوره آموزشی</small></div><div class=\"dv-stat\"><b>۴۹+</b><small>دانشجوی فعال</small></div><div class=\"dv-stat\"><b>۳۵۹+</b><small>ساعت آموزش</small></div><div class=\"dv-stat\"><b>٪۹۰</b><small>رضایت</small></div></div>\n    </div>\n  </div>\n  <div class=\"dv-flex dv-gap-3\" style=\"margin-top:20px;flex-wrap:wrap\"><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#B3272E\">د</span>\n        <b>استاد دکتر سارا محمدی</b>\n        <small>مدرس ارشد برنامه‌نویسی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#5A6B3A\">ع</span>\n        <b>استاد مهندس علی رضایی</b>\n        <small>متخصص طراحی UI/UX</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#E3CFA4\">ن</span>\n        <b>استاد دکتر نگار کریمی</b>\n        <small>دکترای هوش مصنوعی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#B3272E\">ا</span>\n        <b>استاد مهندس امیر حسینی</b>\n        <small>مدرس بازاریابی دیجیتال</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div></div>\n</div>",
    "contact_section": "<div class=\"dv-widget dv-flex dv-gap-4\" style=\"flex-wrap:wrap;align-items:stretch\">\n  <div style=\"flex:1;min-width:220px;border-radius:18px;overflow:hidden;display:flex;flex-direction:column\">\n    <div style=\"flex:1;min-height:200px;background:linear-gradient(160deg,#E3CFA4,#B3272E);display:flex;align-items:center;justify-content:center;font-size:54px\">📍</div>\n  </div>\n  <div style=\"flex:1.2;min-width:260px;background:var(--card);border-radius:18px;padding:22px;border:1px solid var(--border)\">\n    <b style=\"font-size:16px\">ارتباط با ما</b>\n    <div style=\"display:flex;flex-direction:column;gap:10px;margin:12px 0\"><div class=\"dv-cinfo\"><span>🏢</span><div><b>آدرس</b><small>تهران، خیابان آزادی، پلاک ۱۲۳</small></div></div><div class=\"dv-cinfo\"><span>📞</span><div><b>تلفن</b><small>۰۲۱-۱۲۳۴۵۶۷۸</small></div></div><div class=\"dv-cinfo\"><span>✉️</span><div><b>ایمیل</b><small>info@academy.ir</small></div></div><div class=\"dv-cinfo\"><span>🕰</span><div><b>ساعات پاسخگویی</b><small>شنبه تا پنجشنبه ۹ تا ۱۸</small></div></div></div>\n    <form class=\"dv-contact-form\" onsubmit=\"return false\">\n      <div class=\"dv-flex dv-gap-2\"><input placeholder=\"نام و نام خانوادگی\"><input placeholder=\"شماره موبایل\"></div>\n      <input placeholder=\"موضوع پیام\">\n      <textarea rows=\"4\" placeholder=\"متن پیام شما...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">📨 ارسال پیام</button>\n    </form>\n  </div>\n</div>"
