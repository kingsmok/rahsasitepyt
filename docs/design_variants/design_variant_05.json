  "components": {
    "desktop_header": "<header class=\"dv-widget\" style=\"background:var(--bg-2)\">\n  <div class=\"dv-container dv-py-3 dv-flex dv-items-center dv-justify-between dv-gap-4\">\n    <div class=\"dv-flex dv-items-center dv-gap-2\">\n      <div class=\"dv-logo-ic\">س</div>\n      <div><b class=\"dv-text-lg dv-font-black\" style=\"color:var(--text)\">آکادمی آنلاین</b>\n      <small class=\"dv-block dv-text-xs\" style=\"color:var(--primary)\">سفال کویر</small></div>\n    </div>\n    <div class=\"dv-flex dv-items-center dv-gap-4 dv-flex-1\"><div class=\"dv-search\">\n      <input type=\"text\" placeholder=\"جستجوی دوره، استاد، مهارت...\" class=\"dv-search-in\">\n      <button class=\"dv-search-btn\">🔍</button>\n    </div></div>\n    <nav class=\"dv-flex dv-gap-2\"><a class=\"dv-nav-a\" href=\"#\">خانه</a><a class=\"dv-nav-a\" href=\"#\">دوره‌ها</a><a class=\"dv-nav-a\" href=\"#\">اساتید</a><a class=\"dv-nav-a\" href=\"#\">وبلاگ</a><a class=\"dv-nav-a\" href=\"#\">درباره ما</a></nav>\n    <a class=\"dv-btn dv-btn-primary\" href=\"#\">ورود / ثبت‌نام</a>\n  </div>\n</header>",
    "mobile_header": "<div class=\"dv-widget\">\n  <header class=\"dv-mb-bar dv-flex dv-items-center dv-justify-between\">\n    <button class=\"dv-mb-fab\">☰</button>\n    <div class=\"dv-flex dv-items-center dv-gap-2\"><span class=\"dv-logo-ic\">س</span><b>آکادمی آنلاین</b></div>\n    <button class=\"dv-mb-fab\">🛒</button>\n  </header>\n  <nav class=\"dv-drawer dv-drawer-right\">\n    <div class=\"dv-drawer-head\"><b>منوی آکادمی</b><button class=\"dv-mb-fab\">✕</button></div>\n    <a href=\"#\"><span>🏠</span>خانه</a><a href=\"#\"><span>📚</span>دوره‌ها</a><a href=\"#\"><span>👨‍🏫</span>اساتید</a><a href=\"#\"><span>📝</span>وبلاگ</a><a href=\"#\"><span>✉️</span>تماس</a>\n    <a class=\"dv-btn dv-btn-primary\" href=\"#\">ورود / ثبت‌نام</a>\n  </nav>\n</div>",
    "desktop_footer": "<footer class=\"dv-widget\" style=\"background:var(--card);border-top:3px solid #B85C38;color:var(--text)\">\n  <div class=\"dv-container dv-footer-grid\">\n    <div><span class=\"dv-logo-ic\">س</span><p class=\"dv-text-sm\" style=\"color:var(--text-2)\">آجری، خاکستری گرم و سفید — حس اصالت و اعتماد برای آموزش‌های تخصصی</p></div>\n    <div><b>آموزش</b><a href=\"#\" style=\"color:var(--text-2)\">دوره‌ها</a><a href=\"#\" style=\"color:var(--text-2)\">مسیر یادگیری</a><a href=\"#\" style=\"color:var(--text-2)\">آزمون‌ها</a></div>\n    <div><b>شرکت</b><a href=\"#\" style=\"color:var(--text-2)\">درباره</a><a href=\"#\" style=\"color:var(--text-2)\">تماس</a><a href=\"#\" style=\"color:var(--text-2)\">قوانین</a></div>\n    <div><b>شبکه‌ها</b><div class=\"dv-socials\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a><a href=\"#\">🐦</a></div></div>\n  </div>\n  <div class=\"dv-footer-bottom\" style=\"color:var(--text-3)\"><span>© ۱۴۰۵ سفال کویر</span></div>\n</footer>",
    "mobile_footer": "<footer class=\"dv-widget\" style=\"background:var(--footer-bg);color:var(--footer-text);padding:18px 16px;text-align:center\">\n  <span class=\"dv-logo-ic\" style=\"margin:0 auto 8px\">س</span>\n  <b style=\"color:var(--footer-head)\">سفال کویر</b>\n  <p class=\"dv-text-sm\" style=\"color:var(--footer-text-2);margin:6px 0 12px\">مرجع آموزش آنلاین ایرانی</p>\n  <div class=\"dv-flex dv-justify-center dv-gap-2 dv-flex-wrap\" style=\"font-size:12px\">\n    <a href=\"#\" style=\"color:var(--footer-text)\">دوره‌ها</a><a href=\"#\" style=\"color:var(--footer-text)\">اساتید</a>\n    <a href=\"#\" style=\"color:var(--footer-text)\">تماس</a><a href=\"#\" style=\"color:var(--footer-text)\">قوانین</a>\n  </div>\n  <div class=\"dv-footer-bottom\" style=\"font-size:11px;color:var(--footer-text-2);margin-top:12px\">© ۱۴۰۵ سفال کویر</div>\n</footer>",
    "course_card": "<div class=\"dv-widget\">\n  <article class=\"dv-card dv-card-course\" style=\"text-align:center\">\n    <div style=\"height:90px;background:radial-gradient(circle at 30% 30%,#D9A05B,transparent 60%),linear-gradient(135deg,#B85C38,#8A8A80);display:flex;align-items:center;justify-content:center;font-size:40px\">🏆</div>\n    <div class=\"dv-card-body\" style=\"text-align:center\">\n      <span class=\"dv-badge\" style=\"background:var(--accent-soft);color:var(--accent)\">ویژه</span>\n      <h3 class=\"dv-text-base dv-font-black\" style=\"margin-top:6px\">دوره جامع توسعه وب با Flask</h3>\n      <div class=\"dv-flex dv-justify-center dv-gap-2\" style=\"font-size:12px;color:var(--text-3);margin:6px 0\">\n        <span>⭐ ۵.۰</span><span>👥 ۳۲۰۰</span><span>🕰 مادام‌العمر</span>\n      </div>\n      <a class=\"dv-btn dv-btn-primary dv-w-full\" href=\"#\">شروع یادگیری</a>\n      <small style=\"display:block;color:var(--text-3);margin-top:8px\">ضمانت بازگشت وجه ۷ روزه</small>\n    </div>\n  </article>\n</div>",
    "video_section": "<div class=\"dv-widget dv-flex dv-gap-3\" style=\"flex-direction:row-reverse\">\n  <div style=\"flex:2\"><div class=\"dv-player\">\n      <div style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:56px;color:#fff\">▶</div>\n      <div class=\"dv-player-bar\"><span>قسمت ۱ — سفال کویر</span><span style=\"font-size:12px\">⏱ ۱۲:۳۴ / ۴۵:۰۰</span></div>\n    </div></div>\n  <div style=\"flex:1;min-width:200px\"><b style=\"font-size:14px\">🎬 لیست پخش — سفال کویر</b><div class=\"dv-pl-item dv-pl-active\"><span class=\"dv-pl-num\">1</span><div><b>قسمت 1 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">2</span><div><b>قسمت 2 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">3</span><div><b>قسمت 3 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">4</span><div><b>قسمت 4 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div></div>\n</div>",
    "about_section": "<div class=\"dv-widget\" style=\"text-align:center\">\n  <span class=\"dv-badge\" style=\"background:var(--primary-soft);color:var(--primary)\">داستان ما</span>\n  <h2 class=\"dv-text-2xl dv-font-black\" style=\"margin:10px 0\">سفری از دل فرهنگ تا دنیای دیجیتال</h2>\n  <p class=\"dv-text-sm\" style=\"color:var(--text-2);max-width:560px;margin:0 auto 22px\">\n    سفال کویر با باور به آموزش باکیفیت و هویت ایرانی متولد شد؛ از تخصصی - اصیل تا مهارت‌های روز.</p>\n  <div class=\"dv-stats dv-flex dv-gap-2 dv-justify-center dv-flex-wrap\" style=\"margin-bottom:26px\"><div class=\"dv-stat\"><b>۱۲+</b><small>دوره آموزشی</small></div><div class=\"dv-stat\"><b>۴۹+</b><small>دانشجوی فعال</small></div><div class=\"dv-stat\"><b>۳۵۹+</b><small>ساعت آموزش</small></div><div class=\"dv-stat\"><b>٪۹۰</b><small>رضایت</small></div></div>\n  <div class=\"dv-flex dv-gap-3 dv-flex-wrap\" style=\"justify-content:center\"><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#B85C38\">د</span>\n        <b>استاد دکتر سارا محمدی</b>\n        <small>مدرس ارشد برنامه‌نویسی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#D9A05B\">ع</span>\n        <b>استاد مهندس علی رضایی</b>\n        <small>متخصص طراحی UI/UX</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#8A8A80\">ن</span>\n        <b>استاد دکتر نگار کریمی</b>\n        <small>دکترای هوش مصنوعی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#B85C38\">ا</span>\n        <b>استاد مهندس امیر حسینی</b>\n        <small>مدرس بازاریابی دیجیتال</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div></div>\n</div>",
    "contact_section": "<div class=\"dv-widget dv-flex dv-gap-4\" style=\"flex-wrap:wrap\">\n  <div style=\"flex:1.2;min-width:260px;background:var(--card);border-radius:18px;padding:22px;border:1px solid var(--border)\">\n    <b style=\"font-size:16px\">📨 فرم تماس</b><form class=\"dv-contact-form\" onsubmit=\"return false\">\n      <div class=\"dv-flex dv-gap-2\"><input placeholder=\"نام و نام خانوادگی\"><input placeholder=\"شماره موبایل\"></div>\n      <input placeholder=\"موضوع پیام\">\n      <textarea rows=\"4\" placeholder=\"متن پیام شما...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">📨 ارسال پیام</button>\n    </form></div>\n  <div style=\"flex:1;min-width:240px;display:flex;flex-direction:column;gap:10px\"><div class=\"dv-cinfo\"><span>🏢</span><div><b>آدرس</b><small>تهران، خیابان آزادی، پلاک ۱۲۳</small></div></div><div class=\"dv-cinfo\"><span>📞</span><div><b>تلفن</b><small>۰۲۱-۱۲۳۴۵۶۷۸</small></div></div><div class=\"dv-cinfo\"><span>✉️</span><div><b>ایمیل</b><small>info@academy.ir</small></div></div><div class=\"dv-cinfo\"><span>🕰</span><div><b>ساعات پاسخگویی</b><small>شنبه تا پنجشنبه ۹ تا ۱۸</small></div></div>\n    <div style=\"flex:1;min-height:130px;border-radius:14px;background:linear-gradient(135deg,#B85C38,#8A8A80);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700\">🗺 نقشه</div>\n  </div>\n</div>"
  }
