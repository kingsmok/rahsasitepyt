    "mobile_footer": "<footer class=\"dv-widget\" style=\"background:var(--footer-bg);color:var(--footer-text);padding:16px\">\n  <div class=\"dv-flex dv-items-center dv-gap-2\"><span class=\"dv-logo-ic\">م</span><b style=\"color:var(--footer-head)\">میناکاری</b></div>\n  <details class=\"dv-acc\" style=\"margin-top:10px\"><summary>📚 دسته‌بندی دوره‌ها</summary>\n    <a href=\"#\">برنامه‌نویسی</a><a href=\"#\">طراحی</a><a href=\"#\">بازاریابی</a></details>\n  <details class=\"dv-acc\"><summary>🔗 لینک‌های مفید</summary>\n    <a href=\"#\">درباره ما</a><a href=\"#\">تماس</a><a href=\"#\">قوانین</a></details>\n  <div class=\"dv-socials dv-justify-center\" style=\"margin-top:10px\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a></div>\n  <div style=\"font-size:11px;color:var(--footer-text-2);text-align:center;margin-top:10px\">© ۱۴۰۵ میناکاری</div>\n</footer>",
    "course_card": "<div class=\"dv-widget\">\n  <article class=\"dv-card dv-flex\" style=\"max-width:520px\">\n    <div style=\"width:150px;background:linear-gradient(160deg,#2EC4B6,#16324F);display:flex;align-items:center;justify-content:center;font-size:38px\">📚</div>\n    <div class=\"dv-flex-1\" style=\"padding:14px 16px\">\n      <small style=\"color:var(--primary);font-weight:700\">فناوری - مدرن</small>\n      <h3 class=\"dv-text-sm dv-font-black\" style=\"margin:4px 0 6px\">دوره جامع طراحی UI/UX</h3>\n      <div style=\"font-size:12px;color:var(--text-3)\">⭐ ۴.۹ · 👥 ۱۸۴۱ · ⏱ ۴۲س</div>\n      <div class=\"dv-flex dv-items-center dv-justify-between dv-mt-2\">\n        <b style=\"color:var(--primary)\">۸۹۰,۰۰۰ <small>تومان</small></b>\n        <a class=\"dv-btn dv-btn-outline\" href=\"#\">جزئیات</a>\n      </div>\n    </div>\n  </article>\n</div>",
    "video_section": "<div class=\"dv-widget\">\n  <div class=\"dv-player\">\n      <div style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:56px;color:#fff\">▶</div>\n      <div class=\"dv-player-bar\"><span>قسمت ۱ — میناکاری</span><span style=\"font-size:12px\">⏱ ۱۲:۳۴ / ۴۵:۰۰</span></div>\n    </div>\n  <div class=\"dv-flex dv-gap-3\" style=\"margin-top:12px;flex-wrap:wrap\">\n    <div style=\"flex:1;min-width:220px\"><div class=\"dv-notes\"><b>📝 یادداشت‌های من</b>\n      <textarea rows=\"3\" placeholder=\"نکته‌های این جلسه را بنویسید...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">ذخیره یادداشت</button></div></div>\n    <div style=\"flex:1;min-width:220px\"><div class=\"dv-attach\"><b>📎 فایل‌های ضمیمه</b>\n      <a href=\"#\">📄 اسلاید جلسه.pdf</a><a href=\"#\">📦 کد تمرین.zip</a><a href=\"#\">📊 دیتاست.xlsx</a></div></div>\n    <div style=\"flex:1;min-width:220px\"><b>🎬 لیست پخش</b><div class=\"dv-pl-item dv-pl-active\"><span class=\"dv-pl-num\">1</span><div><b>قسمت 1 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">2</span><div><b>قسمت 2 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">3</span><div><b>قسمت 3 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">4</span><div><b>قسمت 4 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div></div>\n  </div>\n</div>",
    "about_section": "<div class=\"dv-widget\" style=\"text-align:center;border:1px solid rgba(22,50,79,0.25);border-radius:22px;padding:28px;position:relative;overflow:hidden\">\n  <div style=\"position:absolute;top:-40px;right:-40px;width:120px;height:120px;border-radius:50%;background:rgba(72,169,166,0.15)\"></div>\n  <span class=\"dv-badge\" style=\"background:#48A9A6;color:#fff\">هنر و اصالت</span>\n  <h2 class=\"dv-text-2xl dv-font-black\" style=\"margin:12px 0\">میناکاری</h2>\n  <p class=\"dv-text-sm\" style=\"color:var(--text-2);max-width:540px;margin:0 auto 20px\">\n    برگرفته از فناوری - مدرن — تلاش می‌کنیم دانش را با همان ظرافت هنر ایرانی منتقل کنیم.</p>\n  <div class=\"dv-flex dv-gap-2 dv-justify-center dv-flex-wrap\" style=\"margin-bottom:22px\"><div class=\"dv-stat\"><b>۱۲+</b><small>دوره آموزشی</small></div><div class=\"dv-stat\"><b>۴۹+</b><small>دانشجوی فعال</small></div><div class=\"dv-stat\"><b>۳۵۹+</b><small>ساعت آموزش</small></div><div class=\"dv-stat\"><b>٪۹۰</b><small>رضایت</small></div></div>\n  <div class=\"dv-flex dv-gap-3 dv-flex-wrap\" style=\"justify-content:center\"><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#16324F\">د</span>\n        <b>استاد دکتر سارا محمدی</b>\n        <small>مدرس ارشد برنامه‌نویسی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#48A9A6\">ع</span>\n        <b>استاد مهندس علی رضایی</b>\n        <small>متخصص طراحی UI/UX</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#2EC4B6\">ن</span>\n        <b>استاد دکتر نگار کریمی</b>\n        <small>دکترای هوش مصنوعی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#16324F\">ا</span>\n        <b>استاد مهندس امیر حسینی</b>\n        <small>مدرس بازاریابی دیجیتال</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div></div>\n</div>",
    "contact_section": "<div class=\"dv-widget\" style=\"text-align:center\">\n  <h2 class=\"dv-text-xl dv-font-black\">راه‌های ارتباط با میناکاری</h2>\n  <p class=\"dv-text-sm\" style=\"color:var(--text-2);margin:6px 0 20px\">همیشه در کنار شما هستیم</p>\n  <div class=\"dv-flex dv-gap-3 dv-flex-wrap\" style=\"justify-content:center\"><div class=\"dv-cinfo\"><span>🏢</span><div><b>آدرس</b><small>تهران، خیابان آزادی، پلاک ۱۲۳</small></div></div><div class=\"dv-cinfo\"><span>📞</span><div><b>تلفن</b><small>۰۲۱-۱۲۳۴۵۶۷۸</small></div></div><div class=\"dv-cinfo\"><span>✉️</span><div><b>ایمیل</b><small>info@academy.ir</small></div></div><div class=\"dv-cinfo\"><span>🕰</span><div><b>ساعات پاسخگویی</b><small>شنبه تا پنجشنبه ۹ تا ۱۸</small></div></div></div>\n  <div class=\"dv-socials\" style=\"justify-content:center;margin-top:18px\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a><a href=\"#\">🐦</a></div>\n  <div style=\"max-width:520px;margin:18px auto 0\"><form class=\"dv-contact-form\" onsubmit=\"return false\">\n      <div class=\"dv-flex dv-gap-2\"><input placeholder=\"نام و نام خانوادگی\"><input placeholder=\"شماره موبایل\"></div>\n      <input placeholder=\"موضوع پیام\">\n      <textarea rows=\"4\" placeholder=\"متن پیام شما...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">📨 ارسال پیام</button>\n    </form></div>\n</div>"
