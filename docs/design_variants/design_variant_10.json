  "components": {
    "desktop_header": "<header class=\"dv-widget\" style=\"background:var(--bg-2)\">\n  <div class=\"dv-container dv-py-3 dv-flex dv-items-center dv-justify-between dv-gap-4\">\n    <div class=\"dv-flex dv-items-center dv-gap-2\">\n      <div class=\"dv-logo-ic\">م</div>\n      <div><b class=\"dv-text-lg dv-font-black\" style=\"color:var(--text)\">آکادمی آنلاین</b>\n      <small class=\"dv-block dv-text-xs\" style=\"color:var(--primary)\">مرمر کهن</small></div>\n    </div>\n    <div class=\"dv-flex dv-items-center dv-gap-4 dv-flex-1\"><div class=\"dv-search\">\n      <input type=\"text\" placeholder=\"جستجوی دوره، استاد، مهارت...\" class=\"dv-search-in\">\n      <button class=\"dv-search-btn\">🔍</button>\n    </div></div>\n    <nav class=\"dv-flex dv-gap-2\"><a class=\"dv-nav-a\" href=\"#\">خانه</a><a class=\"dv-nav-a\" href=\"#\">دوره‌ها</a><a class=\"dv-nav-a\" href=\"#\">اساتید</a><a class=\"dv-nav-a\" href=\"#\">وبلاگ</a><a class=\"dv-nav-a\" href=\"#\">درباره ما</a></nav>\n    <a class=\"dv-btn dv-btn-primary\" href=\"#\">ورود / ثبت‌نام</a>\n  </div>\n</header>",
    "mobile_header": "<div class=\"dv-widget\">\n  <header class=\"dv-mb-bar dv-flex dv-items-center dv-justify-between\">\n    <button class=\"dv-mb-fab\">☰</button>\n    <b style=\"font-size:15px\">آکادمی آنلاین</b>\n    <button class=\"dv-mb-fab\">🔍</button>\n  </header>\n  <nav class=\"dv-drawer dv-drawer-right\">\n    <div class=\"dv-drawer-head\"><b>منو</b><button class=\"dv-mb-fab\">✕</button></div>\n    <a href=\"#\"><span>🏠</span>خانه</a><a href=\"#\"><span>📚</span>دوره‌ها</a><a href=\"#\"><span>👨‍🏫</span>اساتید</a><a href=\"#\"><span>📝</span>وبلاگ</a><a href=\"#\"><span>✉️</span>تماس</a>\n  </nav>\n  <div class=\"dv-bottom-nav\">\n    <a href=\"#\" class=\"dv-bn-item dv-bn-active\"><span>🏠</span><small>خانه</small></a>\n    <a href=\"#\" class=\"dv-bn-item\"><span>📚</span><small>دوره‌ها</small></a>\n    <a href=\"#\" class=\"dv-bn-item\"><span>🔍</span><small>جستجو</small></a>\n    <a href=\"#\" class=\"dv-bn-item\"><span>👤</span><small>پروفایل</small></a>\n  </div>\n</div>",
    "desktop_footer": "<footer class=\"dv-widget\" style=\"background:var(--card);border-top:3px solid #C9A227;color:var(--text)\">\n  <div class=\"dv-container dv-footer-grid\">\n    <div><span class=\"dv-logo-ic\">م</span><p class=\"dv-text-sm\" style=\"color:var(--text-2)\">مشکی زغالی، طلایی و سفید مرمری — تم تاریک لوکس و حرفه‌ای</p></div>\n    <div><b>آموزش</b><a href=\"#\" style=\"color:var(--text-2)\">دوره‌ها</a><a href=\"#\" style=\"color:var(--text-2)\">مسیر یادگیری</a><a href=\"#\" style=\"color:var(--text-2)\">آزمون‌ها</a></div>\n    <div><b>شرکت</b><a href=\"#\" style=\"color:var(--text-2)\">درباره</a><a href=\"#\" style=\"color:var(--text-2)\">تماس</a><a href=\"#\" style=\"color:var(--text-2)\">قوانین</a></div>\n    <div><b>شبکه‌ها</b><div class=\"dv-socials\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a><a href=\"#\">🐦</a></div></div>\n  </div>\n  <div class=\"dv-footer-bottom\" style=\"color:var(--text-3)\"><span>© ۱۴۰۵ مرمر کهن</span></div>\n</footer>",
    "mobile_footer": "<div class=\"dv-widget\">\n  <footer style=\"background:var(--footer-bg);color:var(--footer-text);padding:16px;text-align:center\">\n    <b style=\"color:var(--footer-head)\">مرمر کهن</b>\n    <p class=\"dv-text-sm\" style=\"color:var(--footer-text-2);margin:6px 0 10px\">یادگیری مهارت‌های آینده</p>\n  </footer>\n  <div class=\"dv-sticky-cta\">\n    <a class=\"dv-btn dv-btn-primary\" href=\"#\" style=\"flex:1\">✨ ثبت‌نام رایگان</a>\n    <a class=\"dv-btn dv-btn-accent\" href=\"#\" style=\"flex:1\">💬 پشتیبانی</a>\n  </div>\n</div>",
    "course_card": "<div class=\"dv-widget\">\n  <article class=\"dv-card dv-card-course\" style=\"text-align:center\">\n    <div style=\"height:90px;background:radial-gradient(circle at 30% 30%,#F2EFE6,transparent 60%),linear-gradient(135deg,#C9A227,#8E8E93);display:flex;align-items:center;justify-content:center;font-size:40px\">🏆</div>\n    <div class=\"dv-card-body\" style=\"text-align:center\">\n      <span class=\"dv-badge\" style=\"background:var(--accent-soft);color:var(--accent)\">ویژه</span>\n      <h3 class=\"dv-text-base dv-font-black\" style=\"margin-top:6px\">دوره جامع توسعه وب با Flask</h3>\n      <div class=\"dv-flex dv-justify-center dv-gap-2\" style=\"font-size:12px;color:var(--text-3);margin:6px 0\">\n        <span>⭐ ۵.۰</span><span>👥 ۳۲۰۰</span><span>🕰 مادام‌العمر</span>\n      </div>\n      <a class=\"dv-btn dv-btn-primary dv-w-full\" href=\"#\">شروع یادگیری</a>\n      <small style=\"display:block;color:var(--text-3);margin-top:8px\">ضمانت بازگشت وجه ۷ روزه</small>\n    </div>\n  </article>\n</div>",
    "video_section": "<div class=\"dv-widget\">\n  <div class=\"dv-flex dv-gap-3\" style=\"flex-direction:row\">\n    <div style=\"flex:1;min-width:200px\"><b style=\"font-size:14px\">🎬 لیست پخش</b><div class=\"dv-pl-item dv-pl-active\"><span class=\"dv-pl-num\">1</span><div><b>قسمت 1 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">2</span><div><b>قسمت 2 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">3</span><div><b>قسمت 3 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">4</span><div><b>قسمت 4 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-attach\"><b>📎 فایل‌های ضمیمه</b>\n      <a href=\"#\">📄 اسلاید جلسه.pdf</a><a href=\"#\">📦 کد تمرین.zip</a><a href=\"#\">📊 دیتاست.xlsx</a></div></div>\n    <div style=\"flex:2\"><div class=\"dv-player\">\n      <div style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:56px;color:#fff\">▶</div>\n      <div class=\"dv-player-bar\"><span>قسمت ۱ — مرمر کهن</span><span style=\"font-size:12px\">⏱ ۱۲:۳۴ / ۴۵:۰۰</span></div>\n    </div><div class=\"dv-notes\"><b>📝 یادداشت‌های من</b>\n      <textarea rows=\"3\" placeholder=\"نکته‌های این جلسه را بنویسید...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">ذخیره یادداشت</button></div></div>\n  </div>\n</div>",
    "about_section": "<div class=\"dv-widget\">\n  <div class=\"dv-flex dv-gap-3\" style=\"flex-wrap:wrap\">\n    <div style=\"flex:1;min-width:240px;background:var(--card);border-radius:16px;padding:20px;border-top:4px solid #C9A227\">\n      <b>🎯 مأموریت ما</b><p class=\"dv-text-sm\" style=\"color:var(--text-2);margin-top:6px\">آموزش مهارت‌های واقعی به زبان ساده برای همه ایرانیان.</p></div>\n    <div style=\"flex:1;min-width:240px;background:var(--card);border-radius:16px;padding:20px;border-top:4px solid #F2EFE6\">\n      <b>👁 چشم‌انداز</b><p class=\"dv-text-sm\" style=\"color:var(--text-2);margin-top:6px\">مرجع اول آموزش آنلاین با هویت ایرانی در منطقه.</p></div>\n    <div style=\"flex:1;min-width:240px;background:var(--card);border-radius:16px;padding:20px;border-top:4px solid #8E8E93\">\n      <b>🏆 افتخارات</b><p class=\"dv-text-sm\" style=\"color:var(--text-2);margin-top:6px\">۶ سال حضور مستمر، ۵۰ هزار دانشجو، ۲۰۰ دوره موفق.</p></div>\n  </div>\n  <div class=\"dv-flex dv-gap-3\" style=\"margin-top:20px;flex-wrap:wrap\">\n    <div style=\"flex:2;min-width:240px\"><b style=\"font-size:15px\">اساتید برتر</b><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#C9A227\">د</span>\n        <b>استاد دکتر سارا محمدی</b>\n        <small>مدرس ارشد برنامه‌نویسی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#F2EFE6\">ع</span>\n        <b>استاد مهندس علی رضایی</b>\n        <small>متخصص طراحی UI/UX</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#8E8E93\">ن</span>\n        <b>استاد دکتر نگار کریمی</b>\n        <small>دکترای هوش مصنوعی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#C9A227\">ا</span>\n        <b>استاد مهندس امیر حسینی</b>\n        <small>مدرس بازاریابی دیجیتال</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div></div>\n    <div style=\"flex:1;min-width:200px\"><b style=\"font-size:15px\">آمار کلیدی</b><div class=\"dv-stat\"><b>۱۲+</b><small>دوره آموزشی</small></div><div class=\"dv-stat\"><b>۴۹+</b><small>دانشجوی فعال</small></div><div class=\"dv-stat\"><b>۳۵۹+</b><small>ساعت آموزش</small></div><div class=\"dv-stat\"><b>٪۹۰</b><small>رضایت</small></div></div>\n  </div>\n</div>",
    "contact_section": "<div class=\"dv-widget\" style=\"background:linear-gradient(135deg,#C9A227,rgba(201,162,39,0.75));border-radius:22px;padding:30px;color:#fff;display:flex;gap:24px;flex-wrap:wrap\">\n  <div style=\"flex:1;min-width:230px\">\n    <h2 class=\"dv-text-xl dv-font-black\" style=\"color:#fff\">🎯 مشاوره رایگان انتخاب مسیر</h2>\n    <p style=\"opacity:.9;font-size:13px;margin:8px 0 16px\">کارشناسان ما در کمتر از ۲۴ ساعت با شما تماس می‌گیرند.</p>\n    <div style=\"display:flex;flex-direction:column;gap:8px;font-size:13px\">\n      <span>📞 ۰۲۱-۱۲۳۴۵۶۷۸</span><span>✉️ info@academy.ir</span><span>💬 تلگرام: @academy_ir</span>\n    </div>\n  </div>\n  <div style=\"flex:1;min-width:240px\">\n    <form class=\"dv-contact-form\" onsubmit=\"return false\" style=\"background:#fff;border-radius:16px;padding:18px;color:var(--text)\">\n      <b style=\"color:var(--text)\">فرم درخواست مشاوره</b>\n      <input placeholder=\"نام\"><input placeholder=\"شماره موبایل\">\n      <select><option>دوره برنامه‌نویسی</option><option>دوره طراحی</option><option>دوره بازاریابی</option></select>\n      <button class=\"dv-btn dv-btn-accent dv-w-full\">درخواست مشاوره</button>\n    </form>\n  </div>\n</div>"
  }
