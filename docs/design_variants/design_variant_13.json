  "components": {
    "desktop_header": "<header class=\"dv-widget\" style=\"padding:14px 0;background:var(--header-bg);backdrop-filter:blur(16px);border-bottom:1px solid var(--header-border)\">\n  <div class=\"dv-container dv-flex dv-items-center dv-justify-between dv-gap-4\">\n    <div class=\"dv-flex dv-items-center dv-gap-2\">\n      <div class=\"dv-logo-ic\">چ</div>\n      <div><b class=\"dv-text-lg dv-font-black\" style=\"color:var(--text)\">آکادمی آنلاین</b>\n      <small class=\"dv-block dv-text-xs\" style=\"color:var(--primary)\">چوب و حصیر</small></div>\n    </div>\n    <nav class=\"dv-flex dv-gap-1\"><a class=\"dv-nav-pill\" href=\"#\">خانه</a><a class=\"dv-nav-pill\" href=\"#\">دوره‌ها</a><a class=\"dv-nav-pill\" href=\"#\">اساتید</a><a class=\"dv-nav-pill\" href=\"#\">وبلاگ</a><a class=\"dv-nav-pill\" href=\"#\">درباره ما</a></nav>\n    <div class=\"dv-flex dv-items-center dv-gap-3\"><div class=\"dv-search\">\n      <input type=\"text\" placeholder=\"جستجوی دوره، استاد، مهارت...\" class=\"dv-search-in\">\n      <button class=\"dv-search-btn\">🔍</button>\n    </div><a class=\"dv-btn dv-btn-primary\" href=\"#\">ورود / ثبت‌نام</a></div>\n  </div>\n</header>",
    "mobile_header": "<div class=\"dv-widget\">\n  <header class=\"dv-mb-bar dv-flex dv-items-center dv-justify-between\">\n    <button class=\"dv-mb-fab\">☰</button>\n    <div class=\"dv-flex dv-items-center dv-gap-2\"><span class=\"dv-logo-ic\">چ</span><b>آکادمی آنلاین</b></div>\n    <button class=\"dv-mb-fab\">🛒</button>\n  </header>\n  <nav class=\"dv-drawer dv-drawer-right\">\n    <div class=\"dv-drawer-head\"><b>منوی آکادمی</b><button class=\"dv-mb-fab\">✕</button></div>\n    <a href=\"#\"><span>🏠</span>خانه</a><a href=\"#\"><span>📚</span>دوره‌ها</a><a href=\"#\"><span>👨‍🏫</span>اساتید</a><a href=\"#\"><span>📝</span>وبلاگ</a><a href=\"#\"><span>✉️</span>تماس</a>\n    <a class=\"dv-btn dv-btn-primary\" href=\"#\">ورود / ثبت‌نام</a>\n  </nav>\n</div>",
    "desktop_footer": "<footer class=\"dv-widget\" style=\"background:var(--footer-bg);color:var(--footer-text)\">\n  <div style=\"height:6px;background:linear-gradient(90deg,#7B5B3A,#6B705C,#D9C2A7)\"></div>\n  <div class=\"dv-container dv-footer-grid\">\n    <div>\n      <span class=\"dv-logo-ic\">چ</span>\n      <p class=\"dv-text-sm\" style=\"color:var(--footer-text-2)\">یادگیری با طعم فرهنگ ایرانی — طبیعت - آرامش</p>\n      <div class=\"dv-socials\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a><a href=\"#\">🐦</a></div>\n    </div>\n    <div><b style=\"color:var(--footer-head)\">دوره‌ها</b><a href=\"#\">پایتون</a><a href=\"#\">طراحی</a><a href=\"#\">بازاریابی</a><a href=\"#\">همه دوره‌ها</a></div>\n    <div><b style=\"color:var(--footer-head)\">آکادمی</b><a href=\"#\">داستان ما</a><a href=\"#\">اساتید</a><a href=\"#\">افتخارات</a><a href=\"#\">همکاری</a></div>\n    <div><b style=\"color:var(--footer-head)\">تماس</b>\n      <p class=\"dv-text-sm\" style=\"color:var(--footer-text-2)\">تهران، خیابان آزادی<br>۰۲۱-۱۲۳۴۵۶۷۸<br>info@academy.ir</p></div>\n  </div>\n  <div class=\"dv-footer-bottom\"><span>© ۱۴۰۵ — چوب و حصیر</span></div>\n</footer>",
    "mobile_footer": "<footer class=\"dv-widget\" style=\"background:var(--footer-bg);color:var(--footer-text);padding:18px 16px;text-align:center\">\n  <span class=\"dv-logo-ic\" style=\"margin:0 auto 8px\">چ</span>\n  <b style=\"color:var(--footer-head)\">چوب و حصیر</b>\n  <p class=\"dv-text-sm\" style=\"color:var(--footer-text-2);margin:6px 0 12px\">مرجع آموزش آنلاین ایرانی</p>\n  <div class=\"dv-flex dv-justify-center dv-gap-2 dv-flex-wrap\" style=\"font-size:12px\">\n    <a href=\"#\" style=\"color:var(--footer-text)\">دوره‌ها</a><a href=\"#\" style=\"color:var(--footer-text)\">اساتید</a>\n    <a href=\"#\" style=\"color:var(--footer-text)\">تماس</a><a href=\"#\" style=\"color:var(--footer-text)\">قوانین</a>\n  </div>\n  <div class=\"dv-footer-bottom\" style=\"font-size:11px;color:var(--footer-text-2);margin-top:12px\">© ۱۴۰۵ چوب و حصیر</div>\n</footer>",
    "course_card": "<div class=\"dv-widget\">\n  <article class=\"dv-card dv-card-course\" style=\"border:2px dashed #6B705C\">\n    <div class=\"dv-card-thumb\" style=\"background:linear-gradient(135deg,#6B705C,#7B5B3A)\">\n      <span class=\"dv-badge\" style=\"background:#fff;color:#6B705C\">⚡ پیش‌فروش</span><span style=\"font-size:38px\">🚀</span>\n    </div>\n    <div class=\"dv-card-body\">\n      <h3 class=\"dv-text-base dv-font-black\">دوره جامع بازاریابی دیجیتال — ترم جدید</h3>\n      <div class=\"dv-countdown dv-flex dv-gap-1 dv-justify-center\" style=\"margin:10px 0\">\n        <span class=\"dv-cd\"><b>۰۷</b><small>روز</small></span>\n        <span class=\"dv-cd\"><b>۱۴</b><small>ساعت</small></span>\n        <span class=\"dv-cd\"><b>۳۲</b><small>دقیقه</small></span>\n      </div>\n      <div class=\"dv-flex dv-items-center dv-justify-between\">\n        <b style=\"color:var(--primary)\">۸۹۰,۰۰۰ <small>تومان</small></b>\n        <a class=\"dv-btn dv-btn-accent\" href=\"#\">رزرو پیش‌فروش</a>\n      </div>\n    </div>\n  </article>\n</div>",
    "video_section": "<div class=\"dv-widget dv-flex dv-gap-3\" style=\"flex-direction:row-reverse\">\n  <div style=\"flex:2\"><div class=\"dv-player\">\n      <div style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:56px;color:#fff\">▶</div>\n      <div class=\"dv-player-bar\"><span>قسمت ۱ — چوب و حصیر</span><span style=\"font-size:12px\">⏱ ۱۲:۳۴ / ۴۵:۰۰</span></div>\n    </div></div>\n  <div style=\"flex:1;min-width:200px\"><b style=\"font-size:14px\">🎬 لیست پخش — چوب و حصیر</b><div class=\"dv-pl-item dv-pl-active\"><span class=\"dv-pl-num\">1</span><div><b>قسمت 1 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">2</span><div><b>قسمت 2 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">3</span><div><b>قسمت 3 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">4</span><div><b>قسمت 4 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div></div>\n</div>",
    "about_section": "<div class=\"dv-widget\" style=\"text-align:center\">\n  <span class=\"dv-badge\" style=\"background:var(--primary-soft);color:var(--primary)\">داستان ما</span>\n  <h2 class=\"dv-text-2xl dv-font-black\" style=\"margin:10px 0\">سفری از دل فرهنگ تا دنیای دیجیتال</h2>\n  <p class=\"dv-text-sm\" style=\"color:var(--text-2);max-width:560px;margin:0 auto 22px\">\n    چوب و حصیر با باور به آموزش باکیفیت و هویت ایرانی متولد شد؛ از طبیعت - آرامش تا مهارت‌های روز.</p>\n  <div class=\"dv-stats dv-flex dv-gap-2 dv-justify-center dv-flex-wrap\" style=\"margin-bottom:26px\"><div class=\"dv-stat\"><b>۱۲+</b><small>دوره آموزشی</small></div><div class=\"dv-stat\"><b>۴۹+</b><small>دانشجوی فعال</small></div><div class=\"dv-stat\"><b>۳۵۹+</b><small>ساعت آموزش</small></div><div class=\"dv-stat\"><b>٪۹۰</b><small>رضایت</small></div></div>\n  <div class=\"dv-flex dv-gap-3 dv-flex-wrap\" style=\"justify-content:center\"><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#7B5B3A\">د</span>\n        <b>استاد دکتر سارا محمدی</b>\n        <small>مدرس ارشد برنامه‌نویسی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#6B705C\">ع</span>\n        <b>استاد مهندس علی رضایی</b>\n        <small>متخصص طراحی UI/UX</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#D9C2A7\">ن</span>\n        <b>استاد دکتر نگار کریمی</b>\n        <small>دکترای هوش مصنوعی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#7B5B3A\">ا</span>\n        <b>استاد مهندس امیر حسینی</b>\n        <small>مدرس بازاریابی دیجیتال</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div></div>\n</div>",
    "contact_section": "<div class=\"dv-widget dv-flex dv-gap-4\" style=\"flex-wrap:wrap\">\n  <div style=\"flex:1.2;min-width:260px;background:var(--card);border-radius:18px;padding:22px;border:1px solid var(--border)\">\n    <b style=\"font-size:16px\">📨 فرم تماس</b><form class=\"dv-contact-form\" onsubmit=\"return false\">\n      <div class=\"dv-flex dv-gap-2\"><input placeholder=\"نام و نام خانوادگی\"><input placeholder=\"شماره موبایل\"></div>\n      <input placeholder=\"موضوع پیام\">\n      <textarea rows=\"4\" placeholder=\"متن پیام شما...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">📨 ارسال پیام</button>\n    </form></div>\n  <div style=\"flex:1;min-width:240px;display:flex;flex-direction:column;gap:10px\"><div class=\"dv-cinfo\"><span>🏢</span><div><b>آدرس</b><small>تهران، خیابان آزادی، پلاک ۱۲۳</small></div></div><div class=\"dv-cinfo\"><span>📞</span><div><b>تلفن</b><small>۰۲۱-۱۲۳۴۵۶۷۸</small></div></div><div class=\"dv-cinfo\"><span>✉️</span><div><b>ایمیل</b><small>info@academy.ir</small></div></div><div class=\"dv-cinfo\"><span>🕰</span><div><b>ساعات پاسخگویی</b><small>شنبه تا پنجشنبه ۹ تا ۱۸</small></div></div>\n    <div style=\"flex:1;min-height:130px;border-radius:14px;background:linear-gradient(135deg,#7B5B3A,#D9C2A7);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700\">🗺 نقشه</div>\n  </div>\n</div>"
