    "desktop_footer": "<footer class=\"dv-widget\" style=\"background:var(--card);border-top:3px solid #FFD166;color:var(--text)\">\n  <div class=\"dv-container dv-footer-grid\">\n    <div><span class=\"dv-logo-ic\">ش</span><p class=\"dv-text-sm\" style=\"color:var(--text-2)\">سرمه‌ای بسیار تیره، زرد ستاره‌ای و بنفش تیره — تم تاریک جذاب برای کدنو</p></div>\n    <div><b>آموزش</b><a href=\"#\" style=\"color:var(--text-2)\">دوره‌ها</a><a href=\"#\" style=\"color:var(--text-2)\">مسیر یادگیری</a><a href=\"#\" style=\"color:var(--text-2)\">آزمون‌ها</a></div>\n    <div><b>شرکت</b><a href=\"#\" style=\"color:var(--text-2)\">درباره</a><a href=\"#\" style=\"color:var(--text-2)\">تماس</a><a href=\"#\" style=\"color:var(--text-2)\">قوانین</a></div>\n    <div><b>شبکه‌ها</b><div class=\"dv-socials\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a><a href=\"#\">🐦</a></div></div>\n  </div>\n  <div class=\"dv-footer-bottom\" style=\"color:var(--text-3)\"><span>© ۱۴۰۵ شب کویر</span></div>\n</footer>",
    "mobile_footer": "<footer class=\"dv-widget\" style=\"background:var(--footer-bg);color:var(--footer-text);padding:16px\">\n  <div class=\"dv-flex dv-items-center dv-gap-2\"><span class=\"dv-logo-ic\">ش</span><b style=\"color:var(--footer-head)\">شب کویر</b></div>\n  <details class=\"dv-acc\" style=\"margin-top:10px\"><summary>📚 دسته‌بندی دوره‌ها</summary>\n    <a href=\"#\">برنامه‌نویسی</a><a href=\"#\">طراحی</a><a href=\"#\">بازاریابی</a></details>\n  <details class=\"dv-acc\"><summary>🔗 لینک‌های مفید</summary>\n    <a href=\"#\">درباره ما</a><a href=\"#\">تماس</a><a href=\"#\">قوانین</a></details>\n  <div class=\"dv-socials dv-justify-center\" style=\"margin-top:10px\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a></div>\n  <div style=\"font-size:11px;color:var(--footer-text-2);text-align:center;margin-top:10px\">© ۱۴۰۵ شب کویر</div>\n</footer>",
    "course_card": "<div class=\"dv-widget\">\n  <article class=\"dv-card dv-card-course\" style=\"text-align:center\">\n    <div style=\"height:90px;background:radial-gradient(circle at 30% 30%,#B8C4D6,transparent 60%),linear-gradient(135deg,#FFD166,#7C5CBF);display:flex;align-items:center;justify-content:center;font-size:40px\">🏆</div>\n    <div class=\"dv-card-body\" style=\"text-align:center\">\n      <span class=\"dv-badge\" style=\"background:var(--accent-soft);color:var(--accent)\">ویژه</span>\n      <h3 class=\"dv-text-base dv-font-black\" style=\"margin-top:6px\">دوره جامع توسعه وب با Flask</h3>\n      <div class=\"dv-flex dv-justify-center dv-gap-2\" style=\"font-size:12px;color:var(--text-3);margin:6px 0\">\n        <span>⭐ ۵.۰</span><span>👥 ۳۲۰۰</span><span>🕰 مادام‌العمر</span>\n      </div>\n      <a class=\"dv-btn dv-btn-primary dv-w-full\" href=\"#\">شروع یادگیری</a>\n      <small style=\"display:block;color:var(--text-3);margin-top:8px\">ضمانت بازگشت وجه ۷ روزه</small>\n    </div>\n  </article>\n</div>",
    "video_section": "<div class=\"dv-widget\">\n  <div class=\"dv-player\">\n      <div style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:56px;color:#fff\">▶</div>\n      <div class=\"dv-player-bar\"><span>قسمت ۱ — شب کویر</span><span style=\"font-size:12px\">⏱ ۱۲:۳۴ / ۴۵:۰۰</span></div>\n    </div>\n  <div class=\"dv-flex dv-gap-3\" style=\"margin-top:12px;flex-wrap:wrap\">\n    <div style=\"flex:1;min-width:220px\"><div class=\"dv-notes\"><b>📝 یادداشت‌های من</b>\n      <textarea rows=\"3\" placeholder=\"نکته‌های این جلسه را بنویسید...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">ذخیره یادداشت</button></div></div>\n    <div style=\"flex:1;min-width:220px\"><div class=\"dv-attach\"><b>📎 فایل‌های ضمیمه</b>\n      <a href=\"#\">📄 اسلاید جلسه.pdf</a><a href=\"#\">📦 کد تمرین.zip</a><a href=\"#\">📊 دیتاست.xlsx</a></div></div>\n    <div style=\"flex:1;min-width:220px\"><b>🎬 لیست پخش</b><div class=\"dv-pl-item dv-pl-active\"><span class=\"dv-pl-num\">1</span><div><b>قسمت 1 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">2</span><div><b>قسمت 2 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">3</span><div><b>قسمت 3 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">4</span><div><b>قسمت 4 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div></div>\n  </div>\n</div>",
    "about_section": "<div class=\"dv-widget\" style=\"text-align:center;border:1px solid rgba(255,209,102,0.25);border-radius:22px;padding:28px;position:relative;overflow:hidden\">\n  <div style=\"position:absolute;top:-40px;right:-40px;width:120px;height:120px;border-radius:50%;background:rgba(184,196,214,0.15)\"></div>\n  <span class=\"dv-badge\" style=\"background:#B8C4D6;color:#fff\">هنر و اصالت</span>\n  <h2 class=\"dv-text-2xl dv-font-black\" style=\"margin:12px 0\">شب کویر</h2>\n  <p class=\"dv-text-sm\" style=\"color:var(--text-2);max-width:540px;margin:0 auto 20px\">\n    برگرفته از تیره - برنامه‌نویسی — تلاش می‌کنیم دانش را با همان ظرافت هنر ایرانی منتقل کنیم.</p>\n  <div class=\"dv-flex dv-gap-2 dv-justify-center dv-flex-wrap\" style=\"margin-bottom:22px\"><div class=\"dv-stat\"><b>۱۲+</b><small>دوره آموزشی</small></div><div class=\"dv-stat\"><b>۴۹+</b><small>دانشجوی فعال</small></div><div class=\"dv-stat\"><b>۳۵۹+</b><small>ساعت آموزش</small></div><div class=\"dv-stat\"><b>٪۹۰</b><small>رضایت</small></div></div>\n  <div class=\"dv-flex dv-gap-3 dv-flex-wrap\" style=\"justify-content:center\"><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#FFD166\">د</span>\n        <b>استاد دکتر سارا محمدی</b>\n        <small>مدرس ارشد برنامه‌نویسی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#B8C4D6\">ع</span>\n        <b>استاد مهندس علی رضایی</b>\n        <small>متخصص طراحی UI/UX</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#7C5CBF\">ن</span>\n        <b>استاد دکتر نگار کریمی</b>\n        <small>دکترای هوش مصنوعی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#FFD166\">ا</span>\n        <b>استاد مهندس امیر حسینی</b>\n        <small>مدرس بازاریابی دیجیتال</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div></div>\n</div>",
    "contact_section": "<div class=\"dv-widget\" style=\"text-align:center\">\n  <h2 class=\"dv-text-xl dv-font-black\">راه‌های ارتباط با شب کویر</h2>\n  <p class=\"dv-text-sm\" style=\"color:var(--text-2);margin:6px 0 20px\">همیشه در کنار شما هستیم</p>\n  <div class=\"dv-flex dv-gap-3 dv-flex-wrap\" style=\"justify-content:center\"><div class=\"dv-cinfo\"><span>🏢</span><div><b>آدرس</b><small>تهران، خیابان آزادی، پلاک ۱۲۳</small></div></div><div class=\"dv-cinfo\"><span>📞</span><div><b>تلفن</b><small>۰۲۱-۱۲۳۴۵۶۷۸</small></div></div><div class=\"dv-cinfo\"><span>✉️</span><div><b>ایمیل</b><small>info@academy.ir</small></div></div><div class=\"dv-cinfo\"><span>🕰</span><div><b>ساعات پاسخگویی</b><small>شنبه تا پنجشنبه ۹ تا ۱۸</small></div></div></div>\n  <div class=\"dv-socials\" style=\"justify-content:center;margin-top:18px\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a><a href=\"#\">🐦</a></div>\n  <div style=\"max-width:520px;margin:18px auto 0\"><form class=\"dv-contact-form\" onsubmit=\"return false\">\n      <div class=\"dv-flex dv-gap-2\"><input placeholder=\"نام و نام خانوادگی\"><input placeholder=\"شماره موبایل\"></div>\n      <input placeholder=\"موضوع پیام\">\n      <textarea rows=\"4\" placeholder=\"متن پیام شما...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">📨 ارسال پیام</button>\n    </form></div>\n</div>"
