  "components": {
    "desktop_header": "<header class=\"dv-widget\" style=\"background:var(--card);border-bottom:1px solid var(--border)\">\n  <div class=\"dv-container dv-py-2 dv-flex dv-items-center dv-justify-between\" style=\"border-bottom:1px solid var(--border)\">\n    <div class=\"dv-flex dv-gap-3\" style=\"color:var(--text-2);font-size:12px\">\n      <span>📞 ۰۲۱-۱۲۳۴۵۶۷۸</span><span>✉️ info@academy.ir</span>\n    </div>\n    <div class=\"dv-flex dv-gap-3\" style=\"color:var(--text-2);font-size:12px\">\n      <a href=\"#\" style=\"color:var(--primary)\">ورود</a><span>|</span><a href=\"#\">ثبت‌نام</a>\n    </div>\n  </div>\n  <div class=\"dv-container dv-py-3 dv-flex dv-items-center dv-justify-between dv-gap-4\">\n    <div class=\"dv-flex dv-items-center dv-gap-2\">\n      <div class=\"dv-logo-ic\">خ</div>\n      <div><b class=\"dv-text-lg dv-font-black\" style=\"color:var(--text)\">آکادمی آنلاین</b>\n      <small class=\"dv-block dv-text-xs\" style=\"color:var(--primary)\">خلیج فارس</small></div>\n    </div>\n    <div class=\"dv-mega\">\n      <button class=\"dv-mega-trigger\">☰ همه دسته‌ها</button>\n      <div class=\"dv-mega-panel\">\n        <div class=\"dv-mega-col\"><b>برنامه‌نویسی</b><a href=\"#\">پایتون</a><a href=\"#\">جنگو</a><a href=\"#\">ری‌اکت</a></div>\n        <div class=\"dv-mega-col\"><b>طراحی</b><a href=\"#\">UI/UX</a><a href=\"#\">فتوشاپ</a><a href=\"#\">موشن</a></div>\n        <div class=\"dv-mega-col\"><b>بازاریابی</b><a href=\"#\">دیجیتال</a><a href=\"#\">سئو</a><a href=\"#\">تبلیغات</a></div>\n      </div>\n    </div>\n    <div class=\"dv-search\">\n      <input type=\"text\" placeholder=\"جستجوی دوره، استاد، مهارت...\" class=\"dv-search-in\">\n      <button class=\"dv-search-btn\">🔍</button>\n    </div>\n    <a class=\"dv-btn dv-btn-primary\" href=\"#\">ورود / ثبت‌نام</a>\n  </div>\n</header>",
    "mobile_header": "<div class=\"dv-widget\">\n  <header class=\"dv-mb-bar dv-flex dv-items-center dv-justify-between\">\n    <button class=\"dv-mb-fab\">☰</button>\n    <div class=\"dv-flex dv-items-center dv-gap-2\"><span class=\"dv-logo-ic\">خ</span><b>آکادمی آنلاین</b></div>\n    <button class=\"dv-mb-fab\">🛒</button>\n  </header>\n  <nav class=\"dv-drawer dv-drawer-right\">\n    <div class=\"dv-drawer-head\"><b>منوی آکادمی</b><button class=\"dv-mb-fab\">✕</button></div>\n    <a href=\"#\"><span>🏠</span>خانه</a><a href=\"#\"><span>📚</span>دوره‌ها</a><a href=\"#\"><span>👨‍🏫</span>اساتید</a><a href=\"#\"><span>📝</span>وبلاگ</a><a href=\"#\"><span>✉️</span>تماس</a>\n    <a class=\"dv-btn dv-btn-primary\" href=\"#\">ورود / ثبت‌نام</a>\n  </nav>\n</div>",
    "desktop_footer": "<footer class=\"dv-widget\" style=\"background:var(--footer-bg);color:var(--footer-text);padding:22px 0\">\n  <div class=\"dv-container dv-flex dv-items-center dv-justify-between dv-gap-3 dv-flex-wrap\">\n    <div class=\"dv-flex dv-items-center dv-gap-2\"><span class=\"dv-logo-ic\">خ</span><b style=\"color:var(--footer-head)\">خلیج فارس</b></div>\n    <div class=\"dv-flex dv-gap-3\" style=\"font-size:13px\"><a href=\"#\">درباره</a><a href=\"#\">تماس</a><a href=\"#\">قوانین</a></div>\n    <span style=\"font-size:12px;color:var(--footer-text-2)\">© ۱۴۰۵ — خلیج فارس</span>\n  </div>\n</footer>",
    "mobile_footer": "<footer class=\"dv-widget\" style=\"background:var(--footer-bg);color:var(--footer-text);padding:18px 16px;text-align:center\">\n  <span class=\"dv-logo-ic\" style=\"margin:0 auto 8px\">خ</span>\n  <b style=\"color:var(--footer-head)\">خلیج فارس</b>\n  <p class=\"dv-text-sm\" style=\"color:var(--footer-text-2);margin:6px 0 12px\">مرجع آموزش آنلاین ایرانی</p>\n  <div class=\"dv-flex dv-justify-center dv-gap-2 dv-flex-wrap\" style=\"font-size:12px\">\n    <a href=\"#\" style=\"color:var(--footer-text)\">دوره‌ها</a><a href=\"#\" style=\"color:var(--footer-text)\">اساتید</a>\n    <a href=\"#\" style=\"color:var(--footer-text)\">تماس</a><a href=\"#\" style=\"color:var(--footer-text)\">قوانین</a>\n  </div>\n  <div class=\"dv-footer-bottom\" style=\"font-size:11px;color:var(--footer-text-2);margin-top:12px\">© ۱۴۰۵ خلیج فارس</div>\n</footer>",
    "course_card": "<div class=\"dv-widget\">\n  <article class=\"dv-card dv-flex\" style=\"max-width:520px\">\n    <div style=\"width:150px;background:linear-gradient(160deg,#E9C46A,#0077B6);display:flex;align-items:center;justify-content:center;font-size:38px\">📚</div>\n    <div class=\"dv-flex-1\" style=\"padding:14px 16px\">\n      <small style=\"color:var(--primary);font-weight:700\">ساحلی - روشن</small>\n      <h3 class=\"dv-text-sm dv-font-black\" style=\"margin:4px 0 6px\">دوره جامع طراحی UI/UX</h3>\n      <div style=\"font-size:12px;color:var(--text-3)\">⭐ ۴.۹ · 👥 ۱۸۴۱ · ⏱ ۴۲س</div>\n      <div class=\"dv-flex dv-items-center dv-justify-between dv-mt-2\">\n        <b style=\"color:var(--primary)\">۸۹۰,۰۰۰ <small>تومان</small></b>\n        <a class=\"dv-btn dv-btn-outline\" href=\"#\">جزئیات</a>\n      </div>\n    </div>\n  </article>\n</div>",
    "video_section": "<div class=\"dv-widget dv-flex dv-gap-3\" style=\"flex-direction:row-reverse\">\n  <div style=\"flex:2\"><div class=\"dv-player\">\n      <div style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:56px;color:#fff\">▶</div>\n      <div class=\"dv-player-bar\"><span>قسمت ۱ — خلیج فارس</span><span style=\"font-size:12px\">⏱ ۱۲:۳۴ / ۴۵:۰۰</span></div>\n    </div></div>\n  <div style=\"flex:1;min-width:200px\"><b style=\"font-size:14px\">🎬 لیست پخش — خلیج فارس</b><div class=\"dv-pl-item dv-pl-active\"><span class=\"dv-pl-num\">1</span><div><b>قسمت 1 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">2</span><div><b>قسمت 2 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">3</span><div><b>قسمت 3 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">4</span><div><b>قسمت 4 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div></div>\n</div>",
    "about_section": "<div class=\"dv-widget\" style=\"text-align:center\">\n  <span class=\"dv-badge\" style=\"background:var(--primary-soft);color:var(--primary)\">داستان ما</span>\n  <h2 class=\"dv-text-2xl dv-font-black\" style=\"margin:10px 0\">سفری از دل فرهنگ تا دنیای دیجیتال</h2>\n  <p class=\"dv-text-sm\" style=\"color:var(--text-2);max-width:560px;margin:0 auto 22px\">\n    خلیج فارس با باور به آموزش باکیفیت و هویت ایرانی متولد شد؛ از ساحلی - روشن تا مهارت‌های روز.</p>\n  <div class=\"dv-stats dv-flex dv-gap-2 dv-justify-center dv-flex-wrap\" style=\"margin-bottom:26px\"><div class=\"dv-stat\"><b>۱۲+</b><small>دوره آموزشی</small></div><div class=\"dv-stat\"><b>۴۹+</b><small>دانشجوی فعال</small></div><div class=\"dv-stat\"><b>۳۵۹+</b><small>ساعت آموزش</small></div><div class=\"dv-stat\"><b>٪۹۰</b><small>رضایت</small></div></div>\n  <div class=\"dv-flex dv-gap-3 dv-flex-wrap\" style=\"justify-content:center\"><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#0077B6\">د</span>\n        <b>استاد دکتر سارا محمدی</b>\n        <small>مدرس ارشد برنامه‌نویسی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#48CAE4\">ع</span>\n        <b>استاد مهندس علی رضایی</b>\n        <small>متخصص طراحی UI/UX</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#E9C46A\">ن</span>\n        <b>استاد دکتر نگار کریمی</b>\n        <small>دکترای هوش مصنوعی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#0077B6\">ا</span>\n        <b>استاد مهندس امیر حسینی</b>\n        <small>مدرس بازاریابی دیجیتال</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div></div>\n</div>",
    "contact_section": "<div class=\"dv-widget dv-flex dv-gap-4\" style=\"flex-wrap:wrap\">\n  <div style=\"flex:1.2;min-width:260px;background:var(--card);border-radius:18px;padding:22px;border:1px solid var(--border)\">\n    <b style=\"font-size:16px\">📨 فرم تماس</b><form class=\"dv-contact-form\" onsubmit=\"return false\">\n      <div class=\"dv-flex dv-gap-2\"><input placeholder=\"نام و نام خانوادگی\"><input placeholder=\"شماره موبایل\"></div>\n      <input placeholder=\"موضوع پیام\">\n      <textarea rows=\"4\" placeholder=\"متن پیام شما...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">📨 ارسال پیام</button>\n    </form></div>\n  <div style=\"flex:1;min-width:240px;display:flex;flex-direction:column;gap:10px\"><div class=\"dv-cinfo\"><span>🏢</span><div><b>آدرس</b><small>تهران، خیابان آزادی، پلاک ۱۲۳</small></div></div><div class=\"dv-cinfo\"><span>📞</span><div><b>تلفن</b><small>۰۲۱-۱۲۳۴۵۶۷۸</small></div></div><div class=\"dv-cinfo\"><span>✉️</span><div><b>ایمیل</b><small>info@academy.ir</small></div></div><div class=\"dv-cinfo\"><span>🕰</span><div><b>ساعات پاسخگویی</b><small>شنبه تا پنجشنبه ۹ تا ۱۸</small></div></div>\n    <div style=\"flex:1;min-height:130px;border-radius:14px;background:linear-gradient(135deg,#0077B6,#E9C46A);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700\">🗺 نقشه</div>\n  </div>\n</div>"
  }
