  "components": {
    "desktop_header": "<header class=\"dv-widget\" style=\"background:var(--card)\">\n  <div class=\"dv-container dv-py-4\">\n    <div class=\"dv-flex dv-items-center dv-justify-between\"><div class=\"dv-flex dv-items-center dv-gap-2\">\n      <div class=\"dv-logo-ic\">ب</div>\n      <div><b class=\"dv-text-lg dv-font-black\" style=\"color:var(--text)\">آکادمی آنلاین</b>\n      <small class=\"dv-block dv-text-xs\" style=\"color:var(--primary)\">باغ ایرانی</small></div>\n    </div><a class=\"dv-btn dv-btn-primary\" href=\"#\">ورود / ثبت‌نام</a></div>\n    <nav class=\"dv-nav-line dv-mt-3\"><a href=\"#\">خانه</a><a href=\"#\">دوره‌ها</a><a href=\"#\">اساتید</a><a href=\"#\">وبلاگ</a><a href=\"#\">درباره ما</a></nav>\n  </div>\n</header>",
    "mobile_header": "<div class=\"dv-widget\">\n  <header class=\"dv-mb-bar dv-flex dv-items-center dv-justify-between\">\n    <button class=\"dv-mb-fab\">☰</button><b>آکادمی آنلاین</b><button class=\"dv-mb-fab\">⚙️</button>\n  </header>\n  <nav class=\"dv-drawer dv-drawer-right\">\n    <div class=\"dv-drawer-head\"><b>دسترسی سریع</b><button class=\"dv-mb-fab\">✕</button></div>\n    <details class=\"dv-acc\"><summary>📚 دوره‌ها</summary>\n      <a href=\"#\">پایتون</a><a href=\"#\">جنگو</a><a href=\"#\">ری‌اکت</a><a href=\"#\">طراحی</a></details>\n    <details class=\"dv-acc\"><summary>👨‍🏫 اساتید</summary><a href=\"#\">همه اساتید</a></details>\n    <details class=\"dv-acc\"><summary>📝 وبلاگ</summary><a href=\"#\">جدیدترین مقالات</a></details>\n    <a href=\"#\">خانه</a><a href=\"#\">دوره‌ها</a><a href=\"#\">اساتید</a><a href=\"#\">وبلاگ</a><a href=\"#\">تماس</a>\n  </nav>\n</div>",
    "desktop_footer": "<footer class=\"dv-widget\" style=\"background:var(--footer-bg);color:var(--footer-text)\">\n  <div class=\"dv-container dv-footer-grid\">\n    <div>\n      <span class=\"dv-logo-ic\">ب</span>\n      <div class=\"dv-stats\" style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px\">\n        <div><b style=\"color:var(--footer-head)\">۱۲+</b><small>دوره</small></div>\n        <div><b style=\"color:var(--footer-head)\">۴۹+</b><small>دانشجو</small></div>\n        <div><b style=\"color:var(--footer-head)\">٪۹۰</b><small>رضایت</small></div>\n      </div>\n    </div>\n    <div><b style=\"color:var(--footer-head)\">لینک‌ها</b><a href=\"#\">خانه</a><a href=\"#\">دوره‌ها</a><a href=\"#\">وبلاگ</a><a href=\"#\">سوالات</a></div>\n    <div><b style=\"color:var(--footer-head)\">مشاوره رایگان</b>\n      <p class=\"dv-text-sm\" style=\"color:var(--footer-text-2)\">شماره خود را بگذارید تا تماس بگیریم</p>\n      <div class=\"dv-news\"><input placeholder=\"شماره موبایل\"><button class=\"dv-btn dv-btn-accent\">درخواست</button></div>\n      <div class=\"dv-socials\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a><a href=\"#\">🐦</a></div></div>\n  </div>\n</footer>",
    "mobile_footer": "<footer class=\"dv-widget\" style=\"background:var(--footer-bg);color:var(--footer-text);padding:16px\">\n  <div class=\"dv-flex dv-items-center dv-gap-2\"><span class=\"dv-logo-ic\">ب</span><b style=\"color:var(--footer-head)\">باغ ایرانی</b></div>\n  <details class=\"dv-acc\" style=\"margin-top:10px\"><summary>📚 دسته‌بندی دوره‌ها</summary>\n    <a href=\"#\">برنامه‌نویسی</a><a href=\"#\">طراحی</a><a href=\"#\">بازاریابی</a></details>\n  <details class=\"dv-acc\"><summary>🔗 لینک‌های مفید</summary>\n    <a href=\"#\">درباره ما</a><a href=\"#\">تماس</a><a href=\"#\">قوانین</a></details>\n  <div class=\"dv-socials dv-justify-center\" style=\"margin-top:10px\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a></div>\n  <div style=\"font-size:11px;color:var(--footer-text-2);text-align:center;margin-top:10px\">© ۱۴۰۵ باغ ایرانی</div>\n</footer>",
    "course_card": "<div class=\"dv-widget\">\n  <article class=\"dv-card dv-card-course\">\n    <div class=\"dv-card-thumb\" style=\"background:#000;position:relative\">\n      <span style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:42px;color:#fff;opacity:.9\">▶</span>\n      <span class=\"dv-badge\" style=\"background:var(--danger);color:#fff\">پیش‌نمایش</span>\n    </div>\n    <div class=\"dv-card-body\">\n      <small style=\"color:var(--primary)\">ویدیو معرفی</small>\n      <h3 class=\"dv-text-base dv-font-black\">دوره جامع یادگیری ماشین</h3>\n      <div class=\"dv-flex dv-gap-2\" style=\"font-size:12px;color:var(--text-3)\"><span>🎬 ۲۷ جلسه</span><span>🏅 گواهینامه</span></div>\n      <div class=\"dv-flex dv-items-center dv-justify-between dv-mt-2\">\n        <b style=\"color:var(--primary)\">۸۹۰,۰۰۰ <small>تومان</small></b>\n        <a class=\"dv-btn dv-btn-primary\" href=\"#\">مشاهده دوره</a>\n      </div>\n    </div>\n  </article>\n</div>",
    "video_section": "<div class=\"dv-widget\">\n  <div class=\"dv-player\">\n      <div style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:56px;color:#fff\">▶</div>\n      <div class=\"dv-player-bar\"><span>قسمت ۱ — باغ ایرانی</span><span style=\"font-size:12px\">⏱ ۱۲:۳۴ / ۴۵:۰۰</span></div>\n    </div>\n  <div class=\"dv-flex dv-gap-3\" style=\"margin-top:12px;flex-wrap:wrap\">\n    <div style=\"flex:1;min-width:220px\"><div class=\"dv-notes\"><b>📝 یادداشت‌های من</b>\n      <textarea rows=\"3\" placeholder=\"نکته‌های این جلسه را بنویسید...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">ذخیره یادداشت</button></div></div>\n    <div style=\"flex:1;min-width:220px\"><div class=\"dv-attach\"><b>📎 فایل‌های ضمیمه</b>\n      <a href=\"#\">📄 اسلاید جلسه.pdf</a><a href=\"#\">📦 کد تمرین.zip</a><a href=\"#\">📊 دیتاست.xlsx</a></div></div>\n    <div style=\"flex:1;min-width:220px\"><b>🎬 لیست پخش</b><div class=\"dv-pl-item dv-pl-active\"><span class=\"dv-pl-num\">1</span><div><b>قسمت 1 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">2</span><div><b>قسمت 2 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">3</span><div><b>قسمت 3 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div><div class=\"dv-pl-item \"><span class=\"dv-pl-num\">4</span><div><b>قسمت 4 — عنوان درس</b><small>⏱ ۱۲:۳۴</small></div></div></div>\n  </div>\n</div>",
    "about_section": "<div class=\"dv-widget\" style=\"text-align:center;border:1px solid rgba(27,122,74,0.25);border-radius:22px;padding:28px;position:relative;overflow:hidden\">\n  <div style=\"position:absolute;top:-40px;right:-40px;width:120px;height:120px;border-radius:50%;background:rgba(242,239,231,0.15)\"></div>\n  <span class=\"dv-badge\" style=\"background:#F2EFE7;color:#fff\">هنر و اصالت</span>\n  <h2 class=\"dv-text-2xl dv-font-black\" style=\"margin:12px 0\">باغ ایرانی</h2>\n  <p class=\"dv-text-sm\" style=\"color:var(--text-2);max-width:540px;margin:0 auto 20px\">\n    برگرفته از طبیعت - شاد — تلاش می‌کنیم دانش را با همان ظرافت هنر ایرانی منتقل کنیم.</p>\n  <div class=\"dv-flex dv-gap-2 dv-justify-center dv-flex-wrap\" style=\"margin-bottom:22px\"><div class=\"dv-stat\"><b>۱۲+</b><small>دوره آموزشی</small></div><div class=\"dv-stat\"><b>۴۹+</b><small>دانشجوی فعال</small></div><div class=\"dv-stat\"><b>۳۵۹+</b><small>ساعت آموزش</small></div><div class=\"dv-stat\"><b>٪۹۰</b><small>رضایت</small></div></div>\n  <div class=\"dv-flex dv-gap-3 dv-flex-wrap\" style=\"justify-content:center\"><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#1B7A4A\">د</span>\n        <b>استاد دکتر سارا محمدی</b>\n        <small>مدرس ارشد برنامه‌نویسی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#F2EFE7\">ع</span>\n        <b>استاد مهندس علی رضایی</b>\n        <small>متخصص طراحی UI/UX</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#F4D03F\">ن</span>\n        <b>استاد دکتر نگار کریمی</b>\n        <small>دکترای هوش مصنوعی</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div><div class=\"dv-tcard\"><span class=\"dv-tavatar\" style=\"background:#1B7A4A\">ا</span>\n        <b>استاد مهندس امیر حسینی</b>\n        <small>مدرس بازاریابی دیجیتال</small>\n        <span style=\"color:var(--accent);font-size:12px\">★★★★★</span></div></div>\n</div>",
    "contact_section": "<div class=\"dv-widget\" style=\"text-align:center\">\n  <h2 class=\"dv-text-xl dv-font-black\">راه‌های ارتباط با باغ ایرانی</h2>\n  <p class=\"dv-text-sm\" style=\"color:var(--text-2);margin:6px 0 20px\">همیشه در کنار شما هستیم</p>\n  <div class=\"dv-flex dv-gap-3 dv-flex-wrap\" style=\"justify-content:center\"><div class=\"dv-cinfo\"><span>🏢</span><div><b>آدرس</b><small>تهران، خیابان آزادی، پلاک ۱۲۳</small></div></div><div class=\"dv-cinfo\"><span>📞</span><div><b>تلفن</b><small>۰۲۱-۱۲۳۴۵۶۷۸</small></div></div><div class=\"dv-cinfo\"><span>✉️</span><div><b>ایمیل</b><small>info@academy.ir</small></div></div><div class=\"dv-cinfo\"><span>🕰</span><div><b>ساعات پاسخگویی</b><small>شنبه تا پنجشنبه ۹ تا ۱۸</small></div></div></div>\n  <div class=\"dv-socials\" style=\"justify-content:center;margin-top:18px\"><a href=\"#\">✈️</a><a href=\"#\">📷</a><a href=\"#\">💬</a><a href=\"#\">🐦</a></div>\n  <div style=\"max-width:520px;margin:18px auto 0\"><form class=\"dv-contact-form\" onsubmit=\"return false\">\n      <div class=\"dv-flex dv-gap-2\"><input placeholder=\"نام و نام خانوادگی\"><input placeholder=\"شماره موبایل\"></div>\n      <input placeholder=\"موضوع پیام\">\n      <textarea rows=\"4\" placeholder=\"متن پیام شما...\"></textarea>\n      <button class=\"dv-btn dv-btn-primary dv-w-full\">📨 ارسال پیام</button>\n    </form></div>\n</div>"
  }
