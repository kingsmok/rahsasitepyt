  "layout_components": {
    "homepage": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F8F4EF;color:#352A24;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:1100px;margin:0 auto;text-align:center\">\n    <span style=\"display:inline-block;background:#D9A05B22;color:#D9A05B;font-weight:800;border-radius:99px;padding:6px 18px;font-size:13px\">سفال کویر</span>\n    <h1 style=\"font-size:clamp(26px,4.5vw,44px);font-weight:900;margin:18px 0 12px;color:#352A24\">تخصص، ساخته‌شده با دست‌های توانا</h1>\n    <p style=\"max-width:620px;margin:0 auto 26px;color:#352A2499;font-size:15px\">آموزش‌های فنی و حرفه‌ای با استانداردهای جهانی — مثل سفالگری استادکار.</p>\n    <div style=\"display:flex;gap:12px;justify-content:center;flex-wrap:wrap\">\n      <a href=\"/courses\" style=\"background:#B85C38;color:#fff;text-decoration:none;font-weight:800;padding:13px 30px;border-radius:14px;box-shadow:0 10px 24px #B85C3844\">🔧 دوره‌های تخصصی</a>\n      <a href=\"/about\" style=\"border:2px solid #D9A05B;color:#D9A05B;text-decoration:none;font-weight:800;padding:12px 30px;border-radius:14px\">درباره ما</a>\n    </div>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-top:34px\">\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #B85C3822\"><b style=\"font-size:22px;color:#B85C38\">۱۵۰+</b><div style=\"font-size:12.5px;color:#352A2488\">دوره آموزشی</div></div>\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #B85C3822\"><b style=\"font-size:22px;color:#B85C38\">۵۰,۰۰۰+</b><div style=\"font-size:12.5px;color:#352A2488\">دانشجوی فعال</div></div>\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #B85C3822\"><b style=\"font-size:22px;color:#B85C38\">۲,۰۰۰+</b><div style=\"font-size:12.5px;color:#352A2488\">ساعت آموزش</div></div>\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #B85C3822\"><b style=\"font-size:22px;color:#B85C38\">٪۹۸</b><div style=\"font-size:12.5px;color:#352A2488\">رضایت</div></div>\n    </div>\n  </div></section>",
    "course_card": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F8F4EF;color:#352A24;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:380px;margin:0 auto;background:#fff;border-radius:20px;overflow:hidden;border:1px solid #B85C3822;box-shadow:0 14px 34px #352A2412\">\n    <div style=\"height:170px;background:linear-gradient(135deg,#B85C38,#8A8A80)\"></div>\n    <div style=\"padding:20px\">\n      <span style=\"font-size:11px;color:#B85C38;font-weight:800;background:#B85C3814;padding:4px 12px;border-radius:99px\">دوره جامع</span>\n      <h3 style=\"font-size:17px;font-weight:900;margin:12px 0 8px;color:#352A24\">عنوان دوره نمونه — سفال کویر</h3>\n      <p style=\"font-size:12.5px;color:#352A2488;margin-bottom:14px\">توضیح کوتاه درباره سرفصل‌ها و دستاوردهای این دوره آموزشی…</p>\n      <div style=\"display:flex;align-items:center;justify-content:space-between;border-top:1px dashed #B85C3833;padding-top:14px\">\n        <div><b style=\"font-size:18px;color:#B85C38\">۱,۲۵۰,۰۰۰</b> <small style=\"color:#352A2477\">تومان</small></div>\n        <a href=\"/courses\" style=\"background:#B85C38;color:#fff;text-decoration:none;font-weight:800;padding:10px 22px;border-radius:12px\">خرید سریع 🛒</a>\n      </div>\n    </div>\n  </div></section>",
    "video_player": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F8F4EF;color:#352A24;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:900px;margin:0 auto;display:grid;grid-template-columns:1fr 280px;gap:16px\" class=\"resp\">\n    <div style=\"border-radius:18px;overflow:hidden;background:#000;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;color:#fff;font-size:52px\">▶</div>\n    <div style=\"background:#fff;border:1px solid #B85C3822;border-radius:18px;padding:14px\">\n      <h4 style=\"font-size:14px;font-weight:900;margin-bottom:10px;color:#352A24\">🎬 لیست پخش</h4>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#B85C380d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#B85C38\">1</b> قسمت 1 — عنوان درس</div><div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#B85C380d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#B85C38\">2</b> قسمت 2 — عنوان درس</div><div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#B85C380d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#B85C38\">3</b> قسمت 3 — عنوان درس</div><div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#B85C380d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#B85C38\">4</b> قسمت 4 — عنوان درس</div>\n      <div style=\"margin-top:12px;padding:10px;background:#D9A05B14;border-radius:12px;font-size:12px;color:#D9A05B;font-weight:700\">📝 یادداشت‌برداری و فایل ضمیمه این قسمت</div>\n    </div>\n  </div></section>",
    "about_us": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F8F4EF;color:#352A24;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:1000px;margin:0 auto\">\n    <h2 style=\"font-size:26px;font-weight:900;text-align:center;margin-bottom:8px;color:#352A24\">داستان سفال کویر</h2>\n    <p style=\"text-align:center;color:#352A2488;max-width:640px;margin:0 auto 30px;font-size:14px\">ما با عشق به فرهنگ ایرانی و باور به آموزش باکیفیت، این آکادمی را بنا کردیم.</p>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px\">\n      <div style=\"background:#fff;border-radius:18px;padding:20px;border-top:4px solid #B85C38\"><b style=\"color:#B85C38\">🎯 مأموریت</b><p style=\"font-size:12.5px;color:#352A2488;margin-top:8px\">آموزش مهارت‌های واقعی به زبان ساده برای همه ایرانیان.</p></div>\n      <div style=\"background:#fff;border-radius:18px;padding:20px;border-top:4px solid #D9A05B\"><b style=\"color:#D9A05B\">👁 چشم‌انداز</b><p style=\"font-size:12.5px;color:#352A2488;margin-top:8px\">مرجع اول آموزش آنلاین با هویت ایرانی در منطقه.</p></div>\n      <div style=\"background:#fff;border-radius:18px;padding:20px;border-top:4px solid #B85C38\"><b style=\"color:#B85C38\">🏆 افتخارات</b><p style=\"font-size:12.5px;color:#352A2488;margin-top:8px\">بیش از ۵۰ هزار دانشجو و ۶ سال حضور مستمر.</p></div>\n    </div>\n  </div></section>",
    "contact_us": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F8F4EF;color:#352A24;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:1000px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:18px\" class=\"resp\">\n    <form style=\"background:#fff;border-radius:18px;padding:22px;border:1px solid #B85C3822\">\n      <h3 style=\"font-weight:900;margin-bottom:14px;color:#352A24\">📨 فرم تماس</h3>\n      <input placeholder=\"نام و نام خانوادگی\" style=\"width:100%;padding:11px 14px;border:1.5px solid #B85C3833;border-radius:11px;margin-bottom:10px\">\n      <input placeholder=\"ایمیل\" style=\"width:100%;padding:11px 14px;border:1.5px solid #B85C3833;border-radius:11px;margin-bottom:10px\">\n      <textarea placeholder=\"پیام شما…\" rows=\"4\" style=\"width:100%;padding:11px 14px;border:1.5px solid #B85C3833;border-radius:11px;margin-bottom:12px\"></textarea>\n      <button style=\"background:#B85C38;color:#fff;border:none;font-weight:800;padding:12px 30px;border-radius:12px;cursor:pointer\">ارسال پیام</button>\n    </form>\n    <div style=\"background:#fff;border-radius:18px;padding:22px;border:1px solid #B85C3822;font-size:13px;color:#352A2488\">\n      <h3 style=\"font-weight:900;margin-bottom:14px;color:#352A24\">📍 اطلاعات دسترسی</h3>\n      <div style=\"margin-bottom:10px\">🏢 تهران، خیابان آزادی، پلاک ۱۲۳</div>\n      <div style=\"margin-bottom:10px\">📞 ۰۲۱-۱۲۳۴۵۶۷۸</div>\n      <div style=\"margin-bottom:10px\">✉️ info@academy.ir</div>\n      <div style=\"height:140px;border-radius:14px;background:linear-gradient(135deg,#8A8A80,#B85C3822);display:flex;align-items:center;justify-content:center;color:#B85C38;font-weight:800;margin-top:12px\">🗺 نقشه — شبکه سراسری پشتیبانی</div>\n    </div>\n  </div></section>"
  },
