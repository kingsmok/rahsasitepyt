  "layout_components": {
    "homepage": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F7F3EC;color:#35291C;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:1100px;margin:0 auto;text-align:center\">\n    <span style=\"display:inline-block;background:#6B705C22;color:#6B705C;font-weight:800;border-radius:99px;padding:6px 18px;font-size:13px\">چوب و حصیر</span>\n    <h1 style=\"font-size:clamp(26px,4.5vw,44px);font-weight:900;margin:18px 0 12px;color:#35291C\">دانایی، مثل بافت حصیر</h1>\n    <p style=\"max-width:620px;margin:0 auto 26px;color:#35291C99;font-size:15px\">دوره‌های صنایع دستی، چوب و طبیعت — آرامش در هر گره.</p>\n    <div style=\"display:flex;gap:12px;justify-content:center;flex-wrap:wrap\">\n      <a href=\"/courses\" style=\"background:#7B5B3A;color:#fff;text-decoration:none;font-weight:800;padding:13px 30px;border-radius:14px;box-shadow:0 10px 24px #7B5B3A44\">🪵 کارگاه‌های طبیعت</a>\n      <a href=\"/about\" style=\"border:2px solid #6B705C;color:#6B705C;text-decoration:none;font-weight:800;padding:12px 30px;border-radius:14px\">درباره ما</a>\n    </div>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-top:34px\">\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #7B5B3A22\"><b style=\"font-size:22px;color:#7B5B3A\">۱۵۰+</b><div style=\"font-size:12.5px;color:#35291C88\">دوره آموزشی</div></div>\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #7B5B3A22\"><b style=\"font-size:22px;color:#7B5B3A\">۵۰,۰۰۰+</b><div style=\"font-size:12.5px;color:#35291C88\">دانشجوی فعال</div></div>\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #7B5B3A22\"><b style=\"font-size:22px;color:#7B5B3A\">۲,۰۰۰+</b><div style=\"font-size:12.5px;color:#35291C88\">ساعت آموزش</div></div>\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #7B5B3A22\"><b style=\"font-size:22px;color:#7B5B3A\">٪۹۸</b><div style=\"font-size:12.5px;color:#35291C88\">رضایت</div></div>\n    </div>\n  </div></section>",
    "course_card": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F7F3EC;color:#35291C;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:380px;margin:0 auto;background:#fff;border-radius:20px;overflow:hidden;border:1px solid #7B5B3A22;box-shadow:0 14px 34px #35291C12\">\n    <div style=\"height:170px;background:linear-gradient(135deg,#7B5B3A,#D9C2A7)\"></div>\n    <div style=\"padding:20px\">\n      <span style=\"font-size:11px;color:#7B5B3A;font-weight:800;background:#7B5B3A14;padding:4px 12px;border-radius:99px\">دوره جامع</span>\n      <h3 style=\"font-size:17px;font-weight:900;margin:12px 0 8px;color:#35291C\">عنوان دوره نمونه — چوب و حصیر</h3>\n      <p style=\"font-size:12.5px;color:#35291C88;margin-bottom:14px\">توضیح کوتاه درباره سرفصل‌ها و دستاوردهای این دوره آموزشی…</p>\n      <div style=\"display:flex;align-items:center;justify-content:space-between;border-top:1px dashed #7B5B3A33;padding-top:14px\">\n        <div><b style=\"font-size:18px;color:#7B5B3A\">۱,۲۵۰,۰۰۰</b> <small style=\"color:#35291C77\">تومان</small></div>\n        <a href=\"/courses\" style=\"background:#7B5B3A;color:#fff;text-decoration:none;font-weight:800;padding:10px 22px;border-radius:12px\">خرید سریع 🛒</a>\n      </div>\n    </div>\n  </div></section>",
    "video_player": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F7F3EC;color:#35291C;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:900px;margin:0 auto;display:grid;grid-template-columns:1fr 280px;gap:16px\" class=\"resp\">\n    <div style=\"border-radius:18px;overflow:hidden;background:#000;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;color:#fff;font-size:52px\">▶</div>\n    <div style=\"background:#fff;border:1px solid #7B5B3A22;border-radius:18px;padding:14px\">\n      <h4 style=\"font-size:14px;font-weight:900;margin-bottom:10px;color:#35291C\">🎬 لیست پخش</h4>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#7B5B3A0d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#7B5B3A\">1</b> قسمت 1 — عنوان درس</div><div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#7B5B3A0d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#7B5B3A\">2</b> قسمت 2 — عنوان درس</div><div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#7B5B3A0d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#7B5B3A\">3</b> قسمت 3 — عنوان درس</div><div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#7B5B3A0d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#7B5B3A\">4</b> قسمت 4 — عنوان درس</div>\n      <div style=\"margin-top:12px;padding:10px;background:#6B705C14;border-radius:12px;font-size:12px;color:#6B705C;font-weight:700\">📝 یادداشت‌برداری و فایل ضمیمه این قسمت</div>\n    </div>\n  </div></section>",
    "about_us": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F7F3EC;color:#35291C;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:1000px;margin:0 auto\">\n    <h2 style=\"font-size:26px;font-weight:900;text-align:center;margin-bottom:8px;color:#35291C\">داستان چوب و حصیر</h2>\n    <p style=\"text-align:center;color:#35291C88;max-width:640px;margin:0 auto 30px;font-size:14px\">ما با عشق به فرهنگ ایرانی و باور به آموزش باکیفیت، این آکادمی را بنا کردیم.</p>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px\">\n      <div style=\"background:#fff;border-radius:18px;padding:20px;border-top:4px solid #7B5B3A\"><b style=\"color:#7B5B3A\">🎯 مأموریت</b><p style=\"font-size:12.5px;color:#35291C88;margin-top:8px\">آموزش مهارت‌های واقعی به زبان ساده برای همه ایرانیان.</p></div>\n      <div style=\"background:#fff;border-radius:18px;padding:20px;border-top:4px solid #6B705C\"><b style=\"color:#6B705C\">👁 چشم‌انداز</b><p style=\"font-size:12.5px;color:#35291C88;margin-top:8px\">مرجع اول آموزش آنلاین با هویت ایرانی در منطقه.</p></div>\n      <div style=\"background:#fff;border-radius:18px;padding:20px;border-top:4px solid #7B5B3A\"><b style=\"color:#7B5B3A\">🏆 افتخارات</b><p style=\"font-size:12.5px;color:#35291C88;margin-top:8px\">بیش از ۵۰ هزار دانشجو و ۶ سال حضور مستمر.</p></div>\n    </div>\n  </div></section>",
    "contact_us": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F7F3EC;color:#35291C;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:1000px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:18px\" class=\"resp\">\n    <form style=\"background:#fff;border-radius:18px;padding:22px;border:1px solid #7B5B3A22\">\n      <h3 style=\"font-weight:900;margin-bottom:14px;color:#35291C\">📨 فرم تماس</h3>\n      <input placeholder=\"نام و نام خانوادگی\" style=\"width:100%;padding:11px 14px;border:1.5px solid #7B5B3A33;border-radius:11px;margin-bottom:10px\">\n      <input placeholder=\"ایمیل\" style=\"width:100%;padding:11px 14px;border:1.5px solid #7B5B3A33;border-radius:11px;margin-bottom:10px\">\n      <textarea placeholder=\"پیام شما…\" rows=\"4\" style=\"width:100%;padding:11px 14px;border:1.5px solid #7B5B3A33;border-radius:11px;margin-bottom:12px\"></textarea>\n      <button style=\"background:#7B5B3A;color:#fff;border:none;font-weight:800;padding:12px 30px;border-radius:12px;cursor:pointer\">ارسال پیام</button>\n    </form>\n    <div style=\"background:#fff;border-radius:18px;padding:22px;border:1px solid #7B5B3A22;font-size:13px;color:#35291C88\">\n      <h3 style=\"font-weight:900;margin-bottom:14px;color:#35291C\">📍 اطلاعات دسترسی</h3>\n      <div style=\"margin-bottom:10px\">🏢 تهران، خیابان آزادی، پلاک ۱۲۳</div>\n      <div style=\"margin-bottom:10px\">📞 ۰۲۱-۱۲۳۴۵۶۷۸</div>\n      <div style=\"margin-bottom:10px\">✉️ info@academy.ir</div>\n      <div style=\"height:140px;border-radius:14px;background:linear-gradient(135deg,#D9C2A7,#7B5B3A22);display:flex;align-items:center;justify-content:center;color:#7B5B3A;font-weight:800;margin-top:12px\">🗺 نقشه — شبکه سراسری پشتیبانی</div>\n    </div>\n  </div></section>"
  },
