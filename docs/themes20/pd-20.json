  "layout_components": {
    "homepage": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F3F4F7;color:#22262E;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:1100px;margin:0 auto;text-align:center\">\n    <span style=\"display:inline-block;background:#7A8B9922;color:#7A8B99;font-weight:800;border-radius:99px;padding:6px 18px;font-size:13px\">مدرن تهران</span>\n    <h1 style=\"font-size:clamp(26px,4.5vw,44px);font-weight:900;margin:18px 0 12px;color:#22262E\">مدرن فکر کن، اصیل بیاموز</h1>\n    <p style=\"max-width:620px;margin:0 auto 26px;color:#22262E99;font-size:15px\">ترکیب تکنولوژی روز با ظرافت خط نستعلیق — تجربه‌ای شیشه‌ای و شفاف.</p>\n    <div style=\"display:flex;gap:12px;justify-content:center;flex-wrap:wrap\">\n      <a href=\"/courses\" style=\"background:#4F5D75;color:#fff;text-decoration:none;font-weight:800;padding:13px 30px;border-radius:14px;box-shadow:0 10px 24px #4F5D7544\">🚀 دوره‌های مدرن</a>\n      <a href=\"/about\" style=\"border:2px solid #7A8B99;color:#7A8B99;text-decoration:none;font-weight:800;padding:12px 30px;border-radius:14px\">درباره ما</a>\n    </div>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-top:34px\">\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #4F5D7522\"><b style=\"font-size:22px;color:#4F5D75\">۱۵۰+</b><div style=\"font-size:12.5px;color:#22262E88\">دوره آموزشی</div></div>\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #4F5D7522\"><b style=\"font-size:22px;color:#4F5D75\">۵۰,۰۰۰+</b><div style=\"font-size:12.5px;color:#22262E88\">دانشجوی فعال</div></div>\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #4F5D7522\"><b style=\"font-size:22px;color:#4F5D75\">۲,۰۰۰+</b><div style=\"font-size:12.5px;color:#22262E88\">ساعت آموزش</div></div>\n      <div style=\"background:#fff;border-radius:16px;padding:18px;border:1px solid #4F5D7522\"><b style=\"font-size:22px;color:#4F5D75\">٪۹۸</b><div style=\"font-size:12.5px;color:#22262E88\">رضایت</div></div>\n    </div>\n  </div></section>",
    "course_card": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F3F4F7;color:#22262E;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:380px;margin:0 auto;background:#fff;border-radius:20px;overflow:hidden;border:1px solid #4F5D7522;box-shadow:0 14px 34px #22262E12\">\n    <div style=\"height:170px;background:linear-gradient(135deg,#4F5D75,#B08D57)\"></div>\n    <div style=\"padding:20px\">\n      <span style=\"font-size:11px;color:#4F5D75;font-weight:800;background:#4F5D7514;padding:4px 12px;border-radius:99px\">دوره جامع</span>\n      <h3 style=\"font-size:17px;font-weight:900;margin:12px 0 8px;color:#22262E\">عنوان دوره نمونه — مدرن تهران</h3>\n      <p style=\"font-size:12.5px;color:#22262E88;margin-bottom:14px\">توضیح کوتاه درباره سرفصل‌ها و دستاوردهای این دوره آموزشی…</p>\n      <div style=\"display:flex;align-items:center;justify-content:space-between;border-top:1px dashed #4F5D7533;padding-top:14px\">\n        <div><b style=\"font-size:18px;color:#4F5D75\">۱,۲۵۰,۰۰۰</b> <small style=\"color:#22262E77\">تومان</small></div>\n        <a href=\"/courses\" style=\"background:#4F5D75;color:#fff;text-decoration:none;font-weight:800;padding:10px 22px;border-radius:12px\">خرید سریع 🛒</a>\n      </div>\n    </div>\n  </div></section>",
    "video_player": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F3F4F7;color:#22262E;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:900px;margin:0 auto;display:grid;grid-template-columns:1fr 280px;gap:16px\" class=\"resp\">\n    <div style=\"border-radius:18px;overflow:hidden;background:#000;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;color:#fff;font-size:52px\">▶</div>\n    <div style=\"background:#fff;border:1px solid #4F5D7522;border-radius:18px;padding:14px\">\n      <h4 style=\"font-size:14px;font-weight:900;margin-bottom:10px;color:#22262E\">🎬 لیست پخش</h4>\n      <div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#4F5D750d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#4F5D75\">1</b> قسمت 1 — عنوان درس</div><div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#4F5D750d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#4F5D75\">2</b> قسمت 2 — عنوان درس</div><div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#4F5D750d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#4F5D75\">3</b> قسمت 3 — عنوان درس</div><div style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;background:#4F5D750d;margin-bottom:6px;font-size:12.5px\"><b style=\"color:#4F5D75\">4</b> قسمت 4 — عنوان درس</div>\n      <div style=\"margin-top:12px;padding:10px;background:#7A8B9914;border-radius:12px;font-size:12px;color:#7A8B99;font-weight:700\">📝 یادداشت‌برداری و فایل ضمیمه این قسمت</div>\n    </div>\n  </div></section>",
    "about_us": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F3F4F7;color:#22262E;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:1000px;margin:0 auto\">\n    <h2 style=\"font-size:26px;font-weight:900;text-align:center;margin-bottom:8px;color:#22262E\">داستان مدرن تهران</h2>\n    <p style=\"text-align:center;color:#22262E88;max-width:640px;margin:0 auto 30px;font-size:14px\">ما با عشق به فرهنگ ایرانی و باور به آموزش باکیفیت، این آکادمی را بنا کردیم.</p>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px\">\n      <div style=\"background:#fff;border-radius:18px;padding:20px;border-top:4px solid #4F5D75\"><b style=\"color:#4F5D75\">🎯 مأموریت</b><p style=\"font-size:12.5px;color:#22262E88;margin-top:8px\">آموزش مهارت‌های واقعی به زبان ساده برای همه ایرانیان.</p></div>\n      <div style=\"background:#fff;border-radius:18px;padding:20px;border-top:4px solid #7A8B99\"><b style=\"color:#7A8B99\">👁 چشم‌انداز</b><p style=\"font-size:12.5px;color:#22262E88;margin-top:8px\">مرجع اول آموزش آنلاین با هویت ایرانی در منطقه.</p></div>\n      <div style=\"background:#fff;border-radius:18px;padding:20px;border-top:4px solid #4F5D75\"><b style=\"color:#4F5D75\">🏆 افتخارات</b><p style=\"font-size:12.5px;color:#22262E88;margin-top:8px\">بیش از ۵۰ هزار دانشجو و ۶ سال حضور مستمر.</p></div>\n    </div>\n  </div></section>",
    "contact_us": "<section dir=\"rtl\" style=\"font-family:Vazirmatn,Tahoma,sans-serif;background:#F3F4F7;color:#22262E;padding:40px 20px;line-height:1.9\">\n  <div style=\"max-width:1000px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:18px\" class=\"resp\">\n    <form style=\"background:#fff;border-radius:18px;padding:22px;border:1px solid #4F5D7522\">\n      <h3 style=\"font-weight:900;margin-bottom:14px;color:#22262E\">📨 فرم تماس</h3>\n      <input placeholder=\"نام و نام خانوادگی\" style=\"width:100%;padding:11px 14px;border:1.5px solid #4F5D7533;border-radius:11px;margin-bottom:10px\">\n      <input placeholder=\"ایمیل\" style=\"width:100%;padding:11px 14px;border:1.5px solid #4F5D7533;border-radius:11px;margin-bottom:10px\">\n      <textarea placeholder=\"پیام شما…\" rows=\"4\" style=\"width:100%;padding:11px 14px;border:1.5px solid #4F5D7533;border-radius:11px;margin-bottom:12px\"></textarea>\n      <button style=\"background:#4F5D75;color:#fff;border:none;font-weight:800;padding:12px 30px;border-radius:12px;cursor:pointer\">ارسال پیام</button>\n    </form>\n    <div style=\"background:#fff;border-radius:18px;padding:22px;border:1px solid #4F5D7522;font-size:13px;color:#22262E88\">\n      <h3 style=\"font-weight:900;margin-bottom:14px;color:#22262E\">📍 اطلاعات دسترسی</h3>\n      <div style=\"margin-bottom:10px\">🏢 تهران، خیابان آزادی، پلاک ۱۲۳</div>\n      <div style=\"margin-bottom:10px\">📞 ۰۲۱-۱۲۳۴۵۶۷۸</div>\n      <div style=\"margin-bottom:10px\">✉️ info@academy.ir</div>\n      <div style=\"height:140px;border-radius:14px;background:linear-gradient(135deg,#B08D57,#4F5D7522);display:flex;align-items:center;justify-content:center;color:#4F5D75;font-weight:800;margin-top:12px\">🗺 نقشه — شبکه سراسری پشتیبانی</div>\n    </div>\n  </div></section>"
  },
